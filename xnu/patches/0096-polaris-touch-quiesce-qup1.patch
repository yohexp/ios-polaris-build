 void sweet_touch_init(void);
 
+#define TOUCH_GCC_PA       0x00100000u  /* GCC: QUPv3 wrapper-1 BCR at 0x18000 */
 #define TOUCH_GPIO_NORTH   0x03900000u  /* TLMM NORTH: pins 33/34/99/125 */
 #define TOUCH_GPIO_SOUTH   0x03d00000u  /* TLMM SOUTH: pin 23 (tp_vddio) */
 #define TOUCH_GPIO_VDDIO   23u          /* tp_vddio_vreg, active high */
@@ -69,7 +70,7 @@
 };
 
 static struct {
-	vm_offset_t gpio_n, gpio_s;
+	vm_offset_t gcc, gpio_n, gpio_s;
 	bool started, dead;
