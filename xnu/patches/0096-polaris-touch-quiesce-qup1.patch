 		printf("SWEET TOUCH: MMIO mapping failed\n");
 		goto out;
 	}
@@ -626,9 +628,18 @@
 	printf("SWEET TOUCH: reset high\n");
 	touch_gpio(st.gpio_n, TOUCH_GPIO_RESET, 0, 3, 7, true, true);
 	touch_wait(200);
-	/* IRQ is only an input here; polling drives reports. */
-	printf("SWEET TOUCH: irq input\n");
-	touch_gpio(st.gpio_n, TOUCH_GPIO_IRQ, 0, 3, 7, false, false);
+	/*
+	 * XBL leaves SE14 in GSI mode. Taking its pads as GPIO while the QUP
+	 * wrapper is still live faults the interconnect, so reset wrapper 1
+	 * (GCC_QUPV3_WRAPPER_1_BCR, bit 0) first. The console UART and every
+	 * other iOS device are on wrapper 0 or outside QUPv3.
+	 */
+	printf("SWEET TOUCH: qup1 reset\n");
+	touch_wr(st.gcc, 0x18000, 1);
+	delay(10);
+	touch_wr(st.gcc, 0x18000, 0);
+	delay(10);
+	touch_wait(50);
 	printf("SWEET TOUCH: probing (mux 33/34 to gpio)\n");
 
