 	uint32_t active;
@@ -594,9 +595,10 @@
 	printf("SWEET TOUCH: starting in %u s (bit-banged I2C)\n", delay_s);
 	touch_wait(delay_s * 1000u);
 	printf("SWEET TOUCH: mapping TLMM\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
 	st.gpio_n = ml_io_map(TOUCH_GPIO_NORTH, 0x80000);
 	st.gpio_s = ml_io_map(TOUCH_GPIO_SOUTH, 0x20000);
-	if (!st.gpio_n || !st.gpio_s) {
