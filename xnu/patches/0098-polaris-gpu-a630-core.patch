+ * flame's a640 value (|2) omits the AS bit and mis-walks on polaris. */
+#define TCR2_VAL	((7u << 15) | (1u << 4))
+
+#define GMU_SID		5
+#define GMU_SID_MASK	0
+#define GPU_SID		0
+#define GPU_SID_MASK	0
