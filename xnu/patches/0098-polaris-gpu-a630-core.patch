+/* ---- HFI v1 (a630 legacy) ---- */
+
+static uint32_t q_rd(uint64_t pa)
+{
+	uint32_t v;
+	a6_read(pa, &v, 4);
+	return v;
+}
+
+static void q_wr(uint64_t pa, uint32_t v)
+{
+	a6_write(pa, &v, 4);
+}
+
+static int hfi_send(struct a6_gpu *g, uint32_t id, uint32_t *msg, uint32_t dwords)
+{
+	uint32_t seq = ++g->hfi_seq & 0xfff;
+	msg[0] = (seq << 20) | (dwords << 8) | id;
+
+	uint64_t h = QHDR(g, HFI_Q_CMD);
+	uint32_t w = q_rd(h + 44);
+	for (uint32_t i = 0; i < dwords; i++) {
+		q_wr(hfi_qdata(g, HFI_Q_CMD) + 4 * w, msg[i]);
+		w = (w + 1) % QSIZE;
+	}
+	q_wr(h + 44, w);
+	if (a6_hfi_dump && (id == HFI_H2F_INIT || id == HFI_H2F_TEST))
+		hfi_dump(g);
+	wr32(GMU_REG(GMU_H2G_SET), 1);
+
+	for (int t = 0; t < 5000; t++) {	/* vendor HFI_RSP_TIMEOUT */
+		uint32_t gi = rd32(GMU_REG(GMU_G2H_INFO));
+		if (gi & (1u << 23)) {		/* HFI_IRQ_CM3_FAULT_MASK */
+			wr32(GMU_REG(GMU_G2H_CLR), 1u << 23);
+			a6_log("hfi: msg %u: CM3 fault (info %x)\n", id, gi);
+			return -2;
+		}
+		if (gi & 1) {
+			wr32(GMU_REG(GMU_G2H_CLR), 1);
+			uint64_t rh = QHDR(g, HFI_Q_RESP);
+			while (q_rd(rh + 40) != q_rd(rh + 44)) {
+				uint32_t r = q_rd(rh + 40);
+				uint32_t hdr = q_rd(hfi_qdata(g, HFI_Q_RESP) + 4 * r);
+				uint32_t n = (hdr >> 8) & 0xff, buf[24] = { 0 };
+				for (uint32_t i = 0; i < n && i < 24; i++) {
+					buf[i] = q_rd(hfi_qdata(g, HFI_Q_RESP) + 4 * r);
+					r = (r + 1) % QSIZE;
+				}
+				q_wr(rh + 40, r);
+				q_wr(rh + 32, 1);	/* rx_request: re-arm the GMU interrupt */
+				if ((hdr & 0xff) == 100) {
+					a6_log("hfi: msg %u error %u\n", id, buf[1]);
+					continue;
+				}
+				if (((buf[1] >> 20) & 0xfff) == seq) {
+					if (buf[2])
+						a6_log("hfi: msg %u returned error %d\n", id, buf[2]);
+					return (int)buf[2];
+				}
+			}
+			q_wr(rh + 32, 1);	/* queue empty */
+		}
+		a6_delay_ms(1);
+	}
+	a6_log("hfi: msg %u seq %u: no ack (info %x) rh %u/%u h2graw %x g2hraw %x\n",
+	       id, seq, rd32(GMU_REG(GMU_G2H_INFO)),
+	       q_rd(QHDR(g, HFI_Q_RESP) + 40), q_rd(QHDR(g, HFI_Q_RESP) + 44),
+	       rd32(GMU_REG(GMU_H2G_RAW)), rd32(GMU_REG(GMU_G2H_INFO)));
+	return -1;
+}
+
+static void gmu_fault_dump(struct a6_gpu *g)
+{
+	uint64_t c = SMMU_CB(g->gmu_cb);
+	a6_log("gmu smmu fault: fsr %x far %llx fsynr0 %x\n", rd32(c + CB_FSR),
+	       (unsigned long long)(rd32(c + CB_FAR) | ((uint64_t)rd32(c + CB_FAR + 4) << 32)),
+	       rd32(c + CB_FSYNR0));
+	a6_log("smmu global: gfsr %x/%x gfsynr0 %x gfsynr1 %x gfsynr2 %x\n",
+	       rd32(SMMU + 0x48), rd32(SMMU + 0x448), rd32(SMMU + 0x50),
+	       rd32(SMMU + 0x54), rd32(SMMU + 0x58));
+	uint32_t ao = rd32(GMU_REG(GMU_AO_HOST_INTERRUPT_STATUS));
+	a6_log("gmu ao status %x fence ctrl %x status %x rbbm int %x\n", ao,
+	       rd32(GMU_REG(GMU_AHB_FENCE_CTRL)), rd32(GMU_REG(GMU_AHB_FENCE_STATUS)),
+	       rd32(GMU_REG(GMU_RBBM_INT_UNMASKED_STATUS)));
+	if (ao)
+		wr32(GMU_REG(GMU_AO_HOST_INTERRUPT_CLR), ao);
+}
+
+static void gmu_log_dump(struct a6_gpu *g)
+{
+	static uint8_t raw[0x4000];
+	char line[201];
+	unsigned n = 0;
+
+	a6_read(GMEM_LOG(g), raw, sizeof(raw));
+	a6_log("gmu log hdr: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	       raw[0], raw[1], raw[2], raw[3], raw[4], raw[5], raw[6], raw[7]);
+	for (unsigned i = 0; i < sizeof(raw); i++) {
+		if (raw[i] >= 32 && raw[i] < 127) {
+			if (n < sizeof(line) - 1)
+				line[n++] = (char)raw[i];
+		} else {
+			if (n >= 4) {
+				line[n] = 0;
+				a6_log("gmu log: %s\n", line);
+			}
+			n = 0;
+		}
+	}
+	if (n >= 4) {
+		line[n] = 0;
+		a6_log("gmu log: %s\n", line);
+	}
+}
+
+static int hfi_start_v1(struct a6_gpu *g)
+{
+	static uint32_t msg[256];
+	int rc = 0;
+	uint32_t info = rd32(GMU_REG(GMU_G2H_INFO));
+
+	a6_log("hfi: pre-message info %x\n", info);
+	if (info & (1u << 23)) {
+		wr32(GMU_REG(GMU_G2H_CLR), 1u << 23);
+		a6_log("hfi: cleared CM3 fault before the first message\n");
+	}
+
+	if (a6_hfi_first == 5) {
+		memset(msg, 0, sizeof(msg));
+		int trc = hfi_send(g, HFI_H2F_TEST, msg, 1);
+		a6_log("hfi: TEST-first -> %d\n", trc);
+		rc |= trc;
+	}
+
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 0;				/* seg_id */
+	msg[2] = g->va_log;		/* GMU log/debug buffer, separate from HFI */
+	msg[3] = A6_GMU_LOG_SIZE;
+	msg[4] = 1;				/* GMU_COLD_BOOT */
+	rc |= hfi_send(g, HFI_H2F_INIT, msg, 5);
+
+	memset(msg, 0, sizeof(msg));
+	msg[1] = (1 << 28) | (1 << 19) | (1 << 17);	/* version 1.10 */
+	rc |= hfi_send(g, HFI_H2F_FW_VERSION, msg, 2);
+
+	memset(msg, 0, sizeof(msg));
+	msg[1] = g->ngpu;
+	msg[2] = g->ngmu;
+	for (uint32_t i = 0; i < g->ngpu; i++) {
+		msg[3 + 2 * i] = g->gx_votes[i];
+		msg[4 + 2 * i] = gpu_khz[i];
+	}
+	for (uint32_t i = 0; i < g->ngmu; i++) {
+		msg[35 + 2 * i] = g->cx_votes[i];
+		msg[36 + 2 * i] = gmu_khz[i];
+	}
+	rc |= hfi_send(g, HFI_H2F_PERF_TABLE, msg, 43);
+
+	/* a6xx_build_bw_table() for the sdm845 GMU: fixed off/on levels. */
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 1;		/* bw_level_num */
+	msg[2] = 3;		/* cnoc_cmds_num */
+	msg[3] = 3;		/* ddr_cmds_num */
+	msg[4] = 0x05;		/* cnoc_wait_bitmask */
+	msg[5] = 0x07;		/* ddr_wait_bitmask */
+	msg[6] = 0x50034; msg[7] = 0x5007c; msg[8] = 0x5004c;
+	msg[12] = 0x40000000; msg[13] = 0; msg[14] = 0x40000000;
+	msg[18] = 0x60000001; msg[19] = 0x20000001; msg[20] = 0x60000001;
+	msg[24] = 0x50000; msg[25] = 0x5005c; msg[26] = 0x5000c;
+	msg[32] = 0x40000000; msg[33] = 0x40000000; msg[34] = 0x40000000;
+	rc |= hfi_send(g, HFI_H2F_BW_TABLE, msg, 160);
+
+	memset(msg, 0, sizeof(msg));
+	(void)hfi_send(g, HFI_H2F_TEST, msg, 1);
+
+	/* Vendor gmu_dcvs_set() uses ACK_NONBLOCK + OPTION_AT_LEAST; a blocking
+	 * vote waits on the RPMh/RSC completion and need not ack before the
+	 * GPU is fully up.  Keep it best-effort so CP bring-up can continue. */
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 0;			/* ACK_NONBLOCK */
+	msg[2] = 3u << 28;		/* perf_idx 0, clkset_opt = AT_LEAST */
+	msg[3] = 0;			/* bw_idx 0 */
+	int vrc = hfi_send(g, HFI_H2F_DCVS_VOTE, msg, 4);
+	if (vrc)
+		a6_log("hfi: boot DCVS vote not acked (%d), continuing\n", vrc);
+	a6_log("hfi: v1 tables + vote -> %d, gx gdsc %x\n", rc, rd32(GPUCC + GPUCC_GX_GDSCR));
+	if (rc) {
+		gmu_fault_dump(g);
+		gmu_log_dump(g);
+	}
+	return rc;
+}
+
+static int oob_set(struct a6_gpu *g, int set, int ack, unsigned ms)
+{
+	(void)g;
+	wr32(GMU_REG(GMU_H2G_SET), 1u << set);
+	int rc = wait_bit(GMU_REG(GMU_G2H_INFO), 1u << ack, 1, ms);
+	wr32(GMU_REG(GMU_G2H_CLR), 1u << ack);
+	return rc;
+}
+
+static void oob_clear(int bit)
+{
+	wr32(GMU_REG(GMU_H2G_SET), 1u << bit);
+}
+
+static int gfx_rail_on(struct a6_gpu *g)
+{
+	uint32_t vote = g->gx_votes[g->ngpu - 1];	/* highest level for boot */
+	wr32(GMU_REG(GMU_BOOT_SLUMBER_OPTION), 0);
+	wr32(GMU_REG(GMU_GX_VOTE_IDX), vote & 0xff);
+	wr32(GMU_REG(GMU_MX_VOTE_IDX), (vote >> 8) & 0xff);
+	int rc = oob_set(g, 22, 30, 1000);		/* legacy BOOT_SLUMBER */
+	a6_log("oob boot slumber %s, gx gdsc %x g2h %x\n", rc ? "TIMEOUT" : "acked",
+	       rd32(GPUCC + GPUCC_GX_GDSCR), rd32(GMU_REG(GMU_G2H_INFO)));
+	return rc;
+}
+
+static int sptprac_enable(void)
+{
+	wr32(GMU_REG(GMU_GX_SPTPRAC_POWER_CONTROL), 0x778000);
+	int rc = -1;
+	for (int i = 0; i <= 100; i++) {
+		if ((rd32(GMU_REG(GMU_SPTPRAC_PWR_CLK_STATUS)) & 0x38) == 0x28) {
+			rc = 0;
+			break;
+		}
+		a6_delay_ms(1);
+	}
+	a6_log("sptprac -> %x %s g2h %x\n", rd32(GMU_REG(GMU_SPTPRAC_PWR_CLK_STATUS)),
+	       rc ? "TIMEOUT" : "on", rd32(GMU_REG(GMU_G2H_INFO)));
+	return rc;
+}
+
+static int hfi_start(void)
+{
+	/* vendor gmu_irq_enable: clear pending, unmask MSGQ+CM3 fault, AO 0..2 */
+	wr32(GMU_REG(GMU_G2H_CLR), 0xffffffffu);
+	wr32(GMU_REG(GMU_AO_HOST_INTERRUPT_CLR), 0xffffffffu);
+	wr32(GMU_REG(GMU_G2H_MASK), ~((1u << 0) | (1u << 23)));
+	wr32(GMU_REG(GMU_AO_HOST_INTERRUPT_MASK), ~0x29u);
+	a6_log("hfi start: pre status %x g2h %x masks %x/%x\n", rd32(GMU_REG(GMU_HFI_CTRL_STATUS)),
+	       rd32(GMU_REG(GMU_G2H_INFO)), rd32(GMU_REG(GMU_G2H_MASK)),
+	       rd32(GMU_REG(GMU_AO_HOST_INTERRUPT_MASK)));
+	a6_log("hfi start: h2g en %x/%x/%x/%x raw %x\n", rd32(GMU_REG(GMU_H2G_EN0)),
+	       rd32(GMU_REG(GMU_H2G_EN1)), rd32(GMU_REG(GMU_H2G_EN2)),
+	       rd32(GMU_REG(GMU_H2G_EN3)), rd32(GMU_REG(GMU_H2G_RAW)));
+	if (!(rd32(GMU_REG(GMU_H2G_EN0)) & 1u)) {
+		wr32(GMU_REG(GMU_H2G_EN0), rd32(GMU_REG(GMU_H2G_EN0)) | 1u);
+		a6_log("hfi start: enabled H2G bit0 -> %x\n", rd32(GMU_REG(GMU_H2G_EN0)));
+	}
+	/* vendor a6xx_gmu_hfi_start(): HFI_CTRL_INIT is at 0x1f986, while
+	 * 0x1f980 is the read-only status the firmware sets when ready. */
+	wr32(GMU_REG(GMU_HFI_CTRL_INIT), 1);
+	int rc = wait_bit(GMU_REG(GMU_HFI_CTRL_STATUS), 1, 1, 1000);
+	a6_log("hfi start -> status %x %s g2h %x\n", rd32(GMU_REG(GMU_HFI_CTRL_STATUS)),
+	       rc ? "TIMEOUT" : "on", rd32(GMU_REG(GMU_G2H_INFO)));
+	return rc;
+}
+
+/* ---- zap shader through TrustZone PAS ---- */
+
+#define PAS_GPU		13
+#define ZAP_REGION	0x8c415000ull	/* reserved-memory gpu_region on polaris */
+#define ZAP_SIZE	0x2000u
+#define SCM_PIL(cmd)	(0x42000000ull | (2u << 8) | (cmd))
+
+/* QSEE returns SCM_INTERRUPTED (1) when a non-secure interrupt hits the call.
+ * Linux's __scm_smc_do_quirk resumes with x0 = 1 and the x6 token the TZ
+ * handed back, on the same CPU.  Without this the zap INIT_IMAGE returns 1. */
+#define SCM_INTERRUPTED	1
+#define SCM_MAX_RETRY	10000
+
+static int64_t scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t x[8] = { 0 };
+	uint64_t tok = 0;
+	int i;
+	_disable_preemption();
+	for (i = 0; i < SCM_MAX_RETRY; i++) {
+		x[0] = i ? SCM_INTERRUPTED : SCM_PIL(cmd);
+		x[1] = arginfo;
+		x[2] = a;
+		x[3] = b;
+		x[4] = c;
+		x[5] = 0;
+		x[6] = i ? tok : 0;
+		x[7] = 0;
+		a6_smc(x);
+		if (x[0] != SCM_INTERRUPTED)
+			break;
+		tok = x[6];
+	}
+	_enable_preemption();
+	if (r1)
+		*r1 = x[1];
+	return (int64_t)x[0];
+}
+
+/* Generic ARMv8 SCM call2 (used for the TZ CP SMMU aperture programming). */
+static int64_t scm2(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a,
+    uint64_t b, uint64_t c, uint64_t d, uint64_t *r1)
+{
+	uint64_t x[8] = { 0 };
+	uint64_t fn = 0x42000000ull | ((uint64_t)svc << 8) | cmd, tok = 0;
+	int i;
+	_disable_preemption();
+	for (i = 0; i < SCM_MAX_RETRY; i++) {
+		x[0] = i ? SCM_INTERRUPTED : fn;
+		x[1] = arginfo;
+		x[2] = a;
+		x[3] = b;
+		x[4] = c;
+		x[5] = d;
+		x[6] = i ? tok : 0;
+		x[7] = 0;
+		a6_smc(x);
+		if (x[0] != SCM_INTERRUPTED)
+			break;
+		tok = x[6];
+	}
+	_enable_preemption();
+	if (r1)
+		*r1 = x[1];
+	return (int64_t)x[0];
+}
+
+static int zap_load(struct a6_gpu *g)
+{
+	uint64_t r1 = 0;
+	uint32_t mlen, slen;
+	const uint8_t *mdt = a6_firmware("a630_zap.mdt", &mlen), *b02 = a6_firmware("a630_zap.b02", &slen);
+	uint64_t off = A6_OFF_ZAP_META;
+	uint32_t meta = (uint32_t)a6_pool_pa(g, off);	/* TZ PAS image address (physical) */
+	if (!mdt || !b02 || slen > ZAP_SIZE) {
+		a6_log("zap: missing a630_zap.mdt/.b02\n");
+		return -1;
+	}
+	a6_write(a6_pool_pa(g, off), mdt, mlen);
+	int64_t rc = scm(1, 2 | (2u << 6), PAS_GPU, meta, 0, &r1);
+	a6_log("zap: init image raw rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+	if (rc || r1) {
+		a6_log("zap: init image rc %lld r1 %llx (meta %x)\n", (long long)rc, (unsigned long long)r1, meta);
+		return -1;
+	}
+	/* Vendor/flame sequence: the segment lives in the DT's reserved
+	 * gpu_region, not the metadata buffer. */
+	rc = scm(2, 3, PAS_GPU, ZAP_REGION, ZAP_SIZE, &r1);
+	if (rc || r1) {
+		a6_log("zap: mem setup rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+		return -1;
+	}
+	static uint8_t seg[ZAP_SIZE];
+	memset(seg, 0, sizeof(seg));
+	memcpy(seg, b02, slen);
+	a6_write(ZAP_REGION, seg, ZAP_SIZE);
+	rc = scm(5, 1, PAS_GPU, 0, 0, &r1);
+	a6_log("zap: auth and reset rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+	return rc || r1 ? -1 : 0;
+}
+
+/* ---- ring ---- */
+
+static uint32_t pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^
+				  (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000 | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) | (pm4_parity(op) << 23);
+}
+
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) | (pm4_parity(reg) << 27);
+}
+
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms)
+{
+	if (n >= A6_RING_DW)
+		return -1;
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	unsigned i;
+	for (i = 0; i < timeout_ms * 10; i++) {
+		if (rd32(GREG(CP_RB_RPTR)) == g->wptr && !(rd32(GREG(RBBM_STATUS)) & (1u << 23)))
+			break;
+		if ((i & 7) == 7)
+			a6_delay_ms(1);
+	}
+	bool ok = i < timeout_ms * 10;
+	if (what || !ok)
+		a6_log("ring %s: rptr %x wptr %x status %x int %x hwfault %x cp_status1 %x %s\n",
+		       what ? what : "", rd32(GREG(CP_RB_RPTR)), g->wptr, rd32(GREG(RBBM_STATUS)),
+		       rd32(GREG(RBBM_INT_STATUS)), rd32(GREG(CP_HW_FAULT)), rd32(GREG(CP_STATUS_1)),
+		       ok ? "idle" : "TIMEOUT");
+	return ok ? 0 : -1;
+}
+
+uint32_t a6_fence_read(const struct a6_gpu *g)
+{
+	uint32_t v = 0;
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+	return v;
+}
+
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint32_t fence = ++g->fence;
+	uint32_t dw[] = {
+		a6_pkt7(A6_CP_INDIRECT_BUFFER, 3), (uint32_t)iova, (uint32_t)(iova >> 32), dwords,
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+	};
+	int rc = a6_ring(g, dw, sizeof(dw) / 4, NULL, timeout_ms);
+	return rc || a6_fence_read(g) != fence ? -1 : 0;
+}
+
+int a6_selftest(struct a6_gpu *g)
+{
+	uint64_t spa = a6_pool_pa(g, A6_OFF_SCRATCH + 0x100);
+	uint64_t sva = a6_pool_va(A6_OFF_SCRATCH + 0x100);
+	uint32_t zero = 0, v = 0;
+	a6_write(spa, &zero, 4);
+	uint32_t dw[] = {
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)sva, (uint32_t)(sva >> 32), 0xcafef00d,
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
+	};
+	int rc = a6_ring(g, dw, sizeof(dw) / 4, "selftest", 1000);
+	a6_read(spa, &v, 4);
+	a6_log("selftest: mem[%llx] = %x (want cafef00d) %s\n", (unsigned long long)sva, v,
+	       rc || v != 0xcafef00d ? "FAILED" : "ok");
+	return rc || v != 0xcafef00d ? -1 : 0;
+}
+
+uint32_t
+a6_present_ib(struct a6_gpu *g, uint64_t off, uint64_t src, uint32_t sx, uint32_t sy,
+    uint32_t dx, uint32_t dy, uint32_t w, uint32_t h, uint32_t src_pitch, uint32_t dst_pitch)
+{
+	uint32_t dw[6 * 256], n = 0, bn = 0;
+	uint64_t pa = a6_pool_pa(g, off);
+	for (uint32_t y = 0; y < h; y++) {
+		uint64_t s = src + (uint64_t)(sy + y) * src_pitch + 4ull * sx;
+		uint64_t d = A6_GVA_FB + (uint64_t)(dy + y) * dst_pitch + 4ull * dx;
+		dw[bn++] = a6_pkt7(A6_CP_MEMCPY, 5);
+		dw[bn++] = w;
+		dw[bn++] = (uint32_t)s;
+		dw[bn++] = (uint32_t)(s >> 32);
+		dw[bn++] = (uint32_t)d;
+		dw[bn++] = (uint32_t)(d >> 32);
+		if (bn == sizeof(dw) / 4) {
+			a6_write(pa + 4ull * n, dw, 4ull * bn);
+			n += bn;
+			bn = 0;
+		}
+	}
+	if (bn) {
+		a6_write(pa + 4ull * n, dw, 4ull * bn);
+		n += bn;
+	}
+	return n;
+}
+
+/* ---- 2D blit engine ---- */
+
+/* The state turnip writes before any work (tu6_init_hw + the device's magic
+ * registers), captured on the A640.  The a630 shares the a6xx 2D registers. */
+static const uint32_t blit_init[][2] = {
+	{ 0x9804, 0x1f }, { 0x9805, 1 }, { 0xa0f8, 1 }, { 0xb600, 0x8000 }, { 0x8600, 0 },
+	{ 0xae03, 0x420 }, { 0xae00, 0 }, { 0xbe04, 0 }, { 0x9600, 0x2000000 }, { 0x0e12, 1 },
+	{ 0x8e01, 1 }, { 0x8e04, 0x4100000 }, { 0xae04, 0 }, { 0xae0f, 0x3f }, { 0xb605, 0x44 },
+	{ 0xbe00, 0x80 }, { 0xbe01, 0 }, { 0xab20, 0 }, { 0xb182, 0 }, { 0xbb11, 0 }, { 0xa9a8, 0 },
+	{ 0xab00, 5 }, { 0xa009, 3 }, { 0x8811, 0x10 }, { 0x8110, 0 }, { 0x8818, 0 }, { 0x8819, 0 },
+	{ 0x881a, 0 }, { 0x881b, 0 }, { 0x881c, 0 }, { 0x881d, 0 }, { 0x881e, 0 }, { 0x88f0, 0 },
+	{ 0x9236, 0 }, { 0x9300, 0 }, { 0x9306, 1 }, { 0xb183, 0 }, { 0x80af, 0 }, { 0x8099, 0 },
+	{ 0x980a, 0 }, { 0x9210, 0 }, { 0x9211, 0 }, { 0x9602, 0 }, { 0x9e72, 0 }, { 0xb309, 0xa2 },
+	{ 0xb986, 0xfc }, { 0xa007, 0 }, { 0x8864, 0 }, { 0xb800, 0x102 },
+	{ 0x8e07, 0x10000000 },		/* RB_CCU_CNTL: sysmem, full CCU */
+};
+
+#define EV_CACHE_FLUSH_TS		0x04
+#define EV_PC_CCU_INVALIDATE_COLOR	0x19
+#define EV_PC_CCU_FLUSH_DEPTH_TS	0x1c
+#define EV_PC_CCU_FLUSH_COLOR_TS	0x1d
+#define EV_CACHE_INVALIDATE		0x31
+
+uint32_t
+a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw)
+{
+	(void)g;
+	uint32_t n = 0;
+	uint64_t border = a6_pool_va(A6_OFF_SCRATCH + 0x800);
+	uint64_t ts = a6_pool_va(A6_OFF_SCRATCH + 0x900);
+#define EV(e)		do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)	do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 4); dw[n++] = (e); \
+			     dw[n++] = (uint32_t)ts; dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)	do { dw[n++] = a6_pkt4((r), 1); dw[n++] = (v); } while (0)
+	EV(EV_CACHE_INVALIDATE);
+	REG(0xbb08, 0xfffff);		/* SP_UPDATE_CNTL */
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	for (unsigned i = 0; i < sizeof(blit_init) / sizeof(blit_init[0]); i++) {
+		REG(blit_init[i][0], blit_init[i][1]);
+	}
+	dw[n++] = a6_pkt4(0xb302, 2);	/* TPL1_GFX_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	dw[n++] = a6_pkt4(0xb180, 2);	/* TPL1_CS_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV(EV_PC_CCU_INVALIDATE_COLOR);
+	EV(EV_CACHE_INVALIDATE);
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+
+	REG(0x8c01, 0);			/* RB_A2D_PIXEL_CNTL */
+	REG(0x8c00, 0x00f03000);	/* RB_A2D_BLT_CNTL: 8888 UNORM, mask f */
+	REG(0x8400, 0x00f03000);	/* GRAS_A2D_BLT_CNTL */
+	REG(0xacc0, 0xf180);		/* SP_A2D_OUTPUT_INFO */
+	dw[n++] = a6_pkt4(0x8405, 2);	/* GRAS_A2D_DEST_TL, _BR (inclusive) */
+	dw[n++] = b->dx | (b->dy << 16);
+	dw[n++] = (b->dx + b->dw - 1) | ((b->dy + b->dh - 1) << 16);
+	dw[n++] = a6_pkt4(0x8401, 4);	/* GRAS_A2D_SRC_XMIN..YMAX, 24.8 fixed, inclusive */
+	dw[n++] = b->sx << 8;
+	dw[n++] = (b->sx + b->sw - 1) << 8;
+	dw[n++] = b->sy << 8;
+	dw[n++] = (b->sy + b->sh - 1) << 8;
+	dw[n++] = a6_pkt4(0xb4c0, 5);	/* TPL1_A2D_SRC_TEXTURE_INFO, SIZE, BASE, PITCH */
+	dw[n++] = 0x00500430 | (b->filter ? 0x10000 : 0);	/* 8888, linear, WXYZ */
+	dw[n++] = b->src_w | (b->src_h << 15);
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = b->src_pitch << 3;
+	dw[n++] = a6_pkt4(0xb4ca, 3);	/* TPL1_A2D_SRC_TEXTURE_FLAG_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt4(0x8c17, 4);	/* RB_A2D_DEST_BUFFER_INFO, BASE, PITCH (64 B units) */
+	dw[n++] = 0x430;
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = b->dst_pitch >> 6;
+	dw[n++] = a6_pkt4(0x8c20, 3);	/* RB_A2D_DEST_FLAG_BUFFER_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt7(A6_CP_BLIT, 1);
+	dw[n++] = 3;			/* BLIT_OP_SCALE */
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV_TS(EV_PC_CCU_FLUSH_DEPTH_TS);
+	EV_TS(EV_CACHE_FLUSH_TS);
+#undef EV
+#undef EV_TS
+#undef REG
+	return n;
+}
+
+/* Self-test on scratch buffers (no display): fill 8 rows, blit, read back. */
+int
+a6_blit_test(struct a6_gpu *g)
+{
+	enum { W = 1080, H = 8, PITCH = 4352 };
+	const uint64_t src_off = 0x900000, dst_off = 0xa00000;
+	uint64_t src_pa = a6_pool_pa(g, src_off), dst_pa = a6_pool_pa(g, dst_off);
+	uint32_t row[W];
+	for (uint32_t y = 0; y < H; y++) {
+		for (uint32_t x = 0; x < W; x++) {
+			row[x] = 0xff000000u | ((x * 255u / (W - 1)) << 16) | (y * 16u << 8) |
+			    (255u - (x * 255u / (W - 1)));
+		}
+		a6_write(src_pa + (uint64_t)y * PITCH, row, sizeof(row));
+	}
+	uint32_t zero = 0;
+	for (uint32_t y = 0; y < H; y++) {
+		a6_write(dst_pa + (uint64_t)y * PITCH, &zero, 4);
+	}
+	struct a6_blit b = {
+		.src_iova = a6_pool_va(src_off), .src_w = W, .src_h = H, .src_pitch = PITCH,
+		.sw = W, .sh = H, .dst_iova = a6_pool_va(dst_off), .dst_pitch = PITCH,
+		.dx = 0, .dy = 0, .dw = W, .dh = H, .filter = false,
+	};
+	static uint32_t dw[4096];
+	uint32_t n = a6_blit_ib(g, &b, dw);
+	if (n >= 4096) {
+		a6_log("2d: ib too big (%u)\n", n);
+		return -1;
+	}
+	int rc = a6_ring(g, dw, n, "2d blit", 2000);
+	if (rc) {
+		a6_log("2d: blit ring failed\n");
+		return rc;
+	}
+	uint32_t bad = 0;
+	for (uint32_t y = 0; y < H; y++) {
+		a6_read(dst_pa + (uint64_t)y * PITCH, row, sizeof(row));
+		for (uint32_t x = 0; x < W; x++) {
+			uint32_t want = 0xff000000u | ((x * 255u / (W - 1)) << 16) | (y * 16u << 8) |
+			    (255u - (x * 255u / (W - 1)));
+			if (row[x] != want) {
+				bad++;
+			}
+		}
+	}
+	a6_log("2d: blit %ux%u %s (%u bad)\n", W, H, bad ? "FAILED" : "ok", bad);
+	return bad ? -1 : 0;
+}
+
+/* GPU paint validation: one burst CP_MEM_WRITE row then CP_MEMCPY rows,
+ * into the pool (verified from the CPU) and then the panel. */
+static uint32_t
+paint_px(uint32_t x)
+{
+	uint32_t r = x * 255u / 1079u;
+	return 0xff000000u | (r << 16) | (0x80u << 8) | (255u - r);
+}
+
+static int
+a6_paint_test(struct a6_gpu *g)
+{
+	enum { PW = 1080, PH = 600, PANEL_ROWS = 120 };
+	const uint32_t stride = 4320;
+	uint64_t pa = a6_pool_pa(g, A6_OFF_FREE), va = a6_pool_va(A6_OFF_FREE);
+	static uint32_t dw[4 + PW + 6 * PH];
+	uint32_t n = 0, bad = 0;
+
+	dw[n++] = a6_pkt7(A6_CP_MEM_WRITE, 2 + PW);
+	dw[n++] = (uint32_t)va;
+	dw[n++] = (uint32_t)(va >> 32);
+	for (uint32_t x = 0; x < PW; x++)
+		dw[n++] = paint_px(x);
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	for (uint32_t y = 1; y < PH; y++) {
+		uint64_t dst = va + (uint64_t)y * stride;
+		dw[n++] = a6_pkt7(A6_CP_MEMCPY, 5);
+		dw[n++] = PW;
+		dw[n++] = (uint32_t)va;
+		dw[n++] = (uint32_t)(va >> 32);
+		dw[n++] = (uint32_t)dst;
+		dw[n++] = (uint32_t)(dst >> 32);
+	}
+	int rc = a6_ring(g, dw, n, "paint", 5000);
+	if (rc) {
+		a6_log("paint: CP_MEMCPY band failed\n");
+		return rc;
+	}
+	for (uint32_t y = 0; y < PH; y += 97) {
+		for (uint32_t x = 0; x < PW; x += 251) {
+			uint32_t v = 0;
+			a6_read(pa + (uint64_t)y * stride + 4ull * x, &v, 4);
+			if (v != paint_px(x))
+				bad++;
+		}
+	}
+	a6_log("paint: %ux%u band in pool, %u mismatches %s\n", PW, PH, bad,
+	       bad ? "FAILED" : "ok");
+
+	/* The panel is redrawn by the CPU at 60 Hz, so this is a one-frame
+	 * check that the GPU can write the real framebuffer mapping. */
+	uint64_t fb = A6_GVA_FB + 700ull * stride;
+	n = 0;
+	dw[n++] = a6_pkt7(A6_CP_MEM_WRITE, 2 + PW);
+	dw[n++] = (uint32_t)fb;
+	dw[n++] = (uint32_t)(fb >> 32);
+	for (uint32_t x = 0; x < PW; x++)
+		dw[n++] = paint_px(x);
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	for (uint32_t y = 1; y < PANEL_ROWS; y++) {
+		uint64_t dst = fb + (uint64_t)y * stride;
+		dw[n++] = a6_pkt7(A6_CP_MEMCPY, 5);
+		dw[n++] = PW;
+		dw[n++] = (uint32_t)fb;
+		dw[n++] = (uint32_t)(fb >> 32);
+		dw[n++] = (uint32_t)dst;
+		dw[n++] = (uint32_t)(dst >> 32);
+	}
+	rc = a6_ring(g, dw, n, "paint panel", 5000);
+	a6_log("paint: panel row 700..%u %s\n", 700 + PANEL_ROWS - 1, rc ? "FAILED" : "ok");
+	return bad ? -1 : rc;
+}
+
+/* ---- GPU page tables ---- */
+
+static void map_gpu_low(struct a6_gpu *g)
+{
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1), l2 = a6_pool_pa(g, A6_OFF_GT_L2);
+	zero_pa(l1, 0x2000);
+	wr64(l1 + 0, l2 | 3);		/* VA 0-1 GB */
+	for (uint64_t o = 0; o < A6_POOL_SIZE; o += 0x200000)	/* AP=01, NC, 2 MB blocks */
+		wr64(l2 + 8 * (((A6_GVA_POOL + o) >> 21) & 0x1ff),
+		     (g->pool_pa + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+	for (uint64_t o = 0; o < A6_FB_SIZE; o += 0x200000)
+		wr64(l2 + 8 * (((A6_GVA_FB + o) >> 21) & 0x1ff),
+		     (A6_FB_PA + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+	/*
+	 * GMEM: UCHE's window is GPU VA 0x100000..0x1fffff (hw_init's
+	 * GMEM_RANGE_MIN/MAX), and the GMEM itself is at pool + 0x100000.
+	 * One 2 MB block for VA 0..0x1fffff aliases the pool there, which is
+	 * what Turnip's device info (gmem_base 0x100000) expects.
+	 */
+	wr64(l2, g->pool_pa | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+}
+
+static uint64_t pt_alloc(struct a6_gpu *g)
+{
+	uint64_t off = A6_OFF_PT_ARENA + 0x1000ull * g->pt_next;
+	if (off + 0x1000 > A6_OFF_SQE)
+		return 0;
+	g->pt_next++;
+	zero_pa(a6_pool_pa(g, off), 0x1000);
+	return a6_pool_pa(g, off);
+}
+
+static uint64_t pt_walk(struct a6_gpu *g, uint64_t table, unsigned idx)
+{
+	uint64_t e = 0;
+	a6_read(table + 8ull * idx, &e, 8);
+	if (e & 1)
+		return (e & 3) == 3 ? e & 0xfffffff000ull : 0;	/* 0: a block */
+	uint64_t t = pt_alloc(g);
+	if (t)
+		wr64(table + 8ull * idx, t | 3);
+	return t;
+}
+
+static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_of)(const void *, uint32_t),
+		  const void *arg)
+{
+	static uint64_t pte[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	for (uint32_t i = 0; i < n4k;) {
+		uint64_t va = iova + 0x1000ull * i;
+		uint64_t l2 = pt_walk(g, l1, (va >> 30) & 0x1ff);
+		uint64_t l3 = l2 ? pt_walk(g, l2, (va >> 21) & 0x1ff) : 0;
+		if (!l3) {
+			a6_log("map: no page table for %llx (arena full, or a block there)\n",
+			       (unsigned long long)va);
+			return -1;
+		}
+		unsigned first = (va >> 12) & 0x1ff, k = 0;
+		while (first + k < 512 && i < n4k)
+			pte[k++] = pa_of(arg, i++) | (1u << 10) | (3u << 8) | (1u << 6) | 3u;
+		a6_write(l3 + 8ull * first, pte, 8ull * k);
+	}
+	return 0;
+}
+
+static uint64_t linear_pa(const void *arg, uint32_t i)
+{
+	return *(const uint64_t *)arg + 0x1000ull * i;
+}
+
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size)
+{
+	return map_4k(g, iova, (uint32_t)((size + 0xfff) >> 12), linear_pa, &pa);
+}
+
+struct page_list {
+	const uint64_t *pages;
+	uint32_t shift;
+};
+
+static uint64_t list_pa(const void *arg, uint32_t i)
+{
+	const struct page_list *l = arg;
+	return l->pages[i >> l->shift] + 0x1000ull * (i & ((1u << l->shift) - 1));
+}
+
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	struct page_list l = { pages, 0 };
+	while ((0x1000u << l.shift) < page_size)
+		l.shift++;
+	return map_4k(g, iova, npages << l.shift, list_pa, &l);
+}
+
+void a6_unmap_high(struct a6_gpu *g)
+{
+	static const uint64_t zeros[511];
+	a6_write(a6_pool_pa(g, A6_OFF_GT_L1) + 8, zeros, sizeof(zeros));
+	g->pt_next = 0;
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TCR, 25 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	a6_tlb_flush(g);
+}
+
+/* ---- stage 4: GPU SMMU bank, hw_init, SQE, CP ---- */
+
+static void hw_init_a630(void)
+{
+	/* Clear the VBIF halt and the trusted (secure) memory range. */
+	wr32(GREG(0xf803), 0);				/* RBBM_SECVID_TSB_CNTL */
+	wr32(GREG(0xf800), 0);				/* TRUSTED_BASE_LO */
+	wr32(GREG(0xf801), 0);				/* TRUSTED_BASE_HI */
+	wr32(GREG(0xf802), 0);				/* TRUSTED_SIZE */
+
+	/* 64-bit addressing for every block that takes an address. */
+	wr32(GREG(0x0842), 1);		/* CP */
+	wr32(GREG(0x0c01), 1);		/* VSC */
+	wr32(GREG(0x8601), 1);		/* GRAS */
+	wr32(GREG(0x8e05), 1);		/* RB */
+	wr32(GREG(0x9e01), 1);		/* PC */
+	wr32(GREG(0xbe05), 1);		/* HLSQ */
+	wr32(GREG(0xa601), 1);		/* VFD */
+	wr32(GREG(0x9601), 1);		/* VPC */
+	wr32(GREG(0x0e00), 1);		/* UCHE */
+	wr32(GREG(0xae01), 1);		/* SP */
+	wr32(GREG(0xb601), 1);		/* TPL1 */
+	wr32(GREG(0xf810), 1);		/* SECVID TSB */
+
+	wr32(GREG(0x0010), 3);		/* RBBM_VBIF_CLIENT_QOS_CNTL (a630) */
+	wr32(GREG(0x302a), 9);		/* VBIF_GATE_OFF_WRREQ_EN (a630) */
+	wr32(GREG(0x050b), 0xffffffff);	/* RBBM_PERFCTR_GPU_BUSY_MASKED */
+
+	/* UCHE: write range max, trap base, write-through base. */
+	uint64_t trap = 0x1fffffffff000ull;
+	wr64(GREG(0x0e05), trap + 0xfc0);	/* WRITE_RANGE_MAX */
+	wr64(GREG(0x0e09), trap);		/* TRAP_BASE */
+	wr64(GREG(0x0e07), trap);		/* WRITE_THRU_BASE */
+	wr64(GREG(0x0e0b), 0x100000);		/* GMEM_RANGE_MIN */
+	wr64(GREG(0x0e0d), 0x1fffff);		/* GMEM_RANGE_MAX */
+	wr32(GREG(0x0e18), 0x804);		/* UCHE_FILTER_CNTL */
+	wr32(GREG(0x0e17), 0x4);		/* UCHE_CACHE_WAYS */
+	wr32(GREG(0x0e19), (1u << 7) | 1);	/* UCHE_CLIENT_PF */
+
+	wr32(GREG(0x8c2), 0x010000c0);		/* CP_ROQ_THRESHOLDS_2 */
+	wr32(GREG(0x8c1), 0x8040362c);		/* CP_ROQ_THRESHOLDS_1 */
+	wr32(GREG(0x8c3), 128);			/* CP_MEM_POOL_SIZE */
+	wr32(GREG(0x9e00), 0x00180000);		/* PC_DBG_ECO_CNTL */
+	wr32(GREG(0x098d), 1);			/* CP_AHB_CNTL */
+	wr32(GREG(0x0500), 1);			/* RBBM_PERFCTR_CNTL */
+	wr32(GREG(0x08d0), 0);			/* CP_PERFCTR_CP_SEL[0] */
+	wr32(GREG(0x001f), (1u << 30) | 0x1fffff);	/* RBBM_INTERFACE_HANG_INT_CNTL */
+
+	/* UBWC 2.0 (polaris DT): highest bank bit 15 (hbb_lo=2), 32-byte access. */
+	wr32(GREG(0x8e08), 2u << 1);				/* RB_NC_MODE_CNTL */
+	wr32(GREG(0xb604), 2u << 1);				/* TPL1_NC_MODE_CNTL */
+	wr32(GREG(0xae02), 2u << 1);				/* SP_NC_MODE_CNTL */
+	wr32(GREG(0x0e01), 2u << 21);				/* UCHE_MODE_CNTL */
+	wr32(GREG(0x0534), 0);					/* RBBM_NC_MODE_CNTL */
+}
+
+static int gpu_cp(struct a6_gpu *g)
+{
+	stage("gpu smmu");
+	/* Vendor arm_smmu_context_bank_reset: clear CACHE_LOCK in sACR (GR0+0x10). */
+	uint32_t acr = rd32(SMMU + 0x10);
+	wr32(SMMU + 0x10, acr & ~(1u << 26));
+	a6_log("smmu: sacr %x -> %x\n", acr, rd32(SMMU + 0x10));
+	if (smmu_pick(&g->gpu_smr, &g->gpu_cb, g->gmu_cb + 1, GPU_SID)) {
+		a6_log("smmu: no free smr/cb for the GPU\n");
+		return -1;
+	}
+	map_gpu_low(g);
+	smmu_bank(g->gpu_smr, g->gpu_cb, a6_pool_pa(g, A6_OFF_GT_L1), GPU_SID, GPU_SID_MASK);
+	{
+		uint64_t ar1 = 0;
+		uint32_t ap = 0xFFFF0000u | (uint32_t)g->gpu_cb;	/* CP_APERTURE_REG 0 */
+		int64_t arc = scm2(0xC, 0x1B, 4, ap, 0xFFFFFFFFu, 0xFFFFFFFFu,
+		    0xFFFFFFFFu, &ar1);
+		a6_log("smmu: cp aperture cb%d rc %lld r1 %llx\n", g->gpu_cb,
+		    (long long)arc, (unsigned long long)ar1);
+	}
+	smmu_alias(g->gpu_cb, 2);	/* gfx3d user stream, exact SMR (SID 0 is the CP ring) */
+	STAGE_OK(5, "gpu smmu");
+
+	/* Hold the GX rail on while we program the core. */
+	int rc = oob_set(g, 16, 24, 1000);		/* legacy GPU_SET */
+	a6_log("oob gpu_set %s, gx gdsc %x\n", rc ? "TIMEOUT" : "acked",
+	       rd32(GPUCC + GPUCC_GX_GDSCR));
+	if (!a6_gx_up()) {
+		a6_log("GX not powered; not touching GPU registers\n");
+		return -1;
+	}
+	STAGE_OK(6, "gpu gx on");
+
+	stage("gpu hw_init");
+	hw_init_a630();
+	STAGE_OK(7, "gpu hw_init");
+
+	zero_pa(a6_pool_pa(g, A6_OFF_SQE), A6_OFF_SCRATCH + 0x1000 - A6_OFF_SQE);
+
+	uint32_t len;
+	const uint8_t *sqe = a6_firmware("a630_sqe.fw", &len);
+	if (!sqe || len < 8 || len > 0x10000) {
+		a6_log("no a630_sqe.fw\n");
+		return -1;
+	}
+	a6_write(a6_pool_pa(g, A6_OFF_SQE), sqe + 4, (len - 4 + 3) & ~3u);	/* minus first dword */
+	wr32(GREG(CP_SQE_INSTR_BASE), (uint32_t)a6_pool_va(A6_OFF_SQE));
+	wr32(GREG(CP_SQE_INSTR_BASE + 1), 0);
+	wr32(GREG(CP_RB_BASE), (uint32_t)a6_pool_va(A6_OFF_RING));
+	wr32(GREG(CP_RB_BASE + 1), 0);
+	wr32(GREG(CP_RB_CNTL), 0x0800020c);	/* 32K ring, 32-byte blocks, no rptr update */
+	g->wptr = 0;
+	wr32(GREG(CP_SQE_CNTL), 1);
+
+	uint32_t me_init[] = { a6_pkt7(A6_CP_ME_INIT, 8), 0x2f, 3, 0x20000000, 0, 0, 0, 0, 0 };
+	if (a6_ring(g, me_init, 9, "me_init", 2000))
+		return -1;
+	STAGE_OK(8, "cp me_init");
+	stage("zap");
+	if (zap_load(g)) {
+		/* a6xx without the zap: the GPU stays trusted unless RBBM clears
+		 * it (CP_SET_SECURE_MODE is the a5xx mechanism).  A secured CP
+		 * sends its data writes down the secure SID and they are dropped. */
+		a6_log("zap failed; unsecure via RBBM_SECVID_TRUST_CNTL\n");
+		wr32(GREG(0xf400), 0);
+		a6_log("rb trust cntl -> %x\n", rd32(GREG(0xf400)));
+	} else {
+		STAGE_OK(9, "zap");
+		uint32_t secure[] = { a6_pkt7(A6_CP_SET_SECURE_MODE, 1), 0 };
+		if (a6_ring(g, secure, 2, "secure mode off", 2000))
+			return -1;
+	}
+
+	/* Prove the CP executes while the GX rail is still held on. */
+	stage("cp selftest");
+	rc = a6_selftest(g);
+	if (rc) {
+		uint64_t far = 0;
+		uint32_t syn = 0, fsr = a6_fault_status(g, &far, &syn);
+		a6_log("selftest: cb%d fsr %x far %llx fsynr0 %x\n", g->gpu_cb, fsr,
+		       (unsigned long long)far, syn);
+		if (fsr) {
+			a6_clear_fault(g);
+			rc = a6_selftest(g);
+			a6_log("selftest retry after clear: %s\n", rc ? "FAILED" : "ok");
+		}
+	}
+	STAGE_OK(10, "cp selftest");
+	if (!rc && a6_paint)
+		(void)a6_paint_test(g);		/* validation only */
+	if (!rc && a6_2d)
+		(void)a6_blit_test(g);		/* validation only */
+	(void)sweet_gpu_panel_probe();
+	sweet_gpu_mem_probe();
+	if (!rc && a6_v2)
+		(void)sweet_gpu_v2_test();
+	int running = a6_cp_running(g);
+
+	/* Done touching the GPU: let the GMU power manage it. */
+	oob_clear(24);		/* GPU_SET clear */
+	oob_clear(30);		/* BOOT_SLUMBER clear */
+	a6_log("gpu: cp running=%d gx=%d cx=%d\n", running, a6_gx_up(), a6_cx_up());
+	return rc;
+}
+
+int a6_power_up(struct a6_gpu *g)
+{
+	stage("power cx");
+	if (power_cx())
+		return -1;
+	STAGE_OK(1, "power cx");
+
+	/* arc votes are read from cmd-db (plain RAM) and drive the GX OOB vote. */
+	if (arc_votes(g->gx_votes, gpu_lvl, 7, "gfx.lvl", "mx.lvl", "gx") ||
+	    arc_votes(g->cx_votes, gmu_lvl, 2, "cx.lvl", "mx.lvl", "cx"))
+		return -1;
+	g->ngpu = 7;
+	g->ngmu = 2;
+
+	if (gmu_boot(g))
+		return -1;
+	STAGE_OK(2, "gmu boot");
+	stage("gx rail");
+	if (gfx_rail_on(g))
+		return -1;
+	stage("sptprac");
+	if (sptprac_enable())
+		return -1;
+	stage("hfi start");
+	if (hfi_start())
+		return -1;
+	STAGE_OK(3, "gx/hfi start");
+	stage("hfi v1 tables");
+	if (hfi_start_v1(g))
+		return -1;
+	STAGE_OK(4, "hfi tables");
+	return gpu_cp(g);
+}
+#endif
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
new file mode 100644
index 0000000..3151052
--- /dev/null
+++ b/bsd/dev/sweet_a6xx.h
@@ -0,0 +1,173 @@
+/*
+ * Adreno 630 (SDM845, polaris) core shared by the kernel bring-up
+ * (bsd/dev/sweet_gpu.c) and, later, the userland tool.
+ *
+ * The environment supplies the a6_* hooks below (physical register and
+ * memory access, delays, logging, SMC, firmware).  The register sequences
+ * follow the mainline msm a6xx driver (a6xx_gmu.c / a6xx_gpu.c / a6xx_hfi.c)
+ * and the vendor kgsl driver in upstream/kernel-sdm845 (a6xx_reg.h,
+ * kgsl_gmu.c, adreno_a6xx.c), with the a630-specific deltas:
+ *
+ *   - GMU is legacy: raw a630_gmu.bin is copied straight into ITCM
+ *     (TCM_BOOT), HFI uses the v1 message set and response queue id 4.
+ *   - RSC/PDC live in the GMU block (0x23400..) and AOSS PDC at 0xb200000,
+ *     not at the a640 RSCC/PDC addresses.
+ *   - GX is brought up through the OOB BOOT_SLUMBER handshake and SPTPRAC.
+ *   - The GPU SMMU is the Adreno SMMU-v2 at 0x5040000; the GMU stream is
+ *     SID 5 / mask 0x400, the GPU stream is exactly SID 0 (polaris
+ *     SMRs reject nonzero masks).
+ *
+ * One 16 MB contiguous pool (2 MB aligned) holds the GPU's own memory:
+ *
+ *   pool + 0x000000  GMU page tables, icache/dcache windows, log, HFI
+ *   pool + 0x0a0000  zap shader metadata for TrustZone
+ *   pool + 0x100000  GPU page tables: L1, L2 (2 MB blocks), then 4K tables
+ *   pool + 0x200000  SQE microcode
+ *   pool + 0x210000  ringbuffer (32 KB)
+ *   pool + 0x218000  scratch: fence (+0), selftest value (+0x100), ...
+ *
+ * GPU VA (39 bits): the pool at 0x10000000, the panel framebuffer at
+ * 0x20000000, everything else from 4 GB up.
+ */
+#ifndef SWEET_A6XX_H
+#define SWEET_A6XX_H
+#ifdef KERNEL
+#include <sys/types.h>
+#include <stdarg.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#endif
+
+#define A6_POOL_SIZE		0x1000000ull
+#define A6_POOL_ALIGN		0x200000ull
+#define A6_OFF_ZAP_META		0x0a0000ull
+#define A6_OFF_GT_L1		0x100000ull
+#define A6_OFF_GT_L2		0x101000ull
+#define A6_OFF_PT_ARENA		0x102000ull
+#define A6_OFF_SQE		0x200000ull
+#define A6_OFF_RING		0x210000ull
+#define A6_OFF_SCRATCH		0x218000ull
+#define A6_OFF_FREE		0x400000ull
+#define A6_OFF_PRESENT		0x800000ull	/* CP_MEMCPY present IB (52 KB) */
+
+#define A6_GVA_POOL		0x10000000ull
+#define A6_GVA_FB		0x20000000ull
+#define A6_RING_SIZE		0x8000u
+#define A6_RING_DW		(A6_RING_SIZE / 4)
+
+#define A6_FB_PA		0x9d400000ull
+#define A6_FB_SIZE		0xa00000ull
+
+#define A6_GPU_ID		630
+#define A6_CHIP_ID		0x06030001ull
+#define A6_GMU_CHIP_ID		0x06030100u	/* hardware 0x06030001 packed for the GMU */
+#define A6_GMEM_SIZE		0x100000ull
+
+struct a6_gpu {
+	uint64_t pool_pa;
+	int32_t gmu_smr, gmu_cb, gpu_smr, gpu_cb;
+	uint32_t wptr;			/* ring write pointer, dwords */
+	uint32_t fence;			/* last fence value submitted */
+	uint32_t hfi_seq;
+	uint32_t pt_next;		/* next free table in the arena */
+	uint32_t gx_votes[8];
+	uint32_t cx_votes[2];
+	uint32_t ngpu, ngmu;
+	uint32_t va_hfi, va_log, va_dummy;
+};
+
+/* ---- environment ---- */
+uint32_t a6_rd(uint64_t pa);
+void a6_wr(uint64_t pa, uint32_t v);
+int a6_write(uint64_t pa, const void *buf, size_t len);	/* DRAM: any size; MMIO: words */
+int a6_read(uint64_t pa, void *buf, size_t len);
+void a6_delay_ms(unsigned ms);
+void a6_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+void a6_smc(uint64_t x[8]);				/* x0..x7 in, x0..x3 out */
+const uint8_t *a6_firmware(const char *name, uint32_t *len);	/* NULL if missing */
+
+/* ---- core ---- */
+static inline uint64_t a6_pool_pa(const struct a6_gpu *g, uint64_t off) { return g->pool_pa + off; }
+static inline uint64_t a6_pool_va(uint64_t off) { return A6_GVA_POOL + off; }
+
+/* Diagnostic stop point: 1=CX, 2=GMU boot, 3=GX/HFI start, 4=HFI tables, 5=CP. */
+extern int a6_stage_limit;
+extern int a6_hfi_table_size_dw;
+extern int a6_hfi_layout;
+extern int a6_hfi_base_mode;
+extern int a6_hfi_qids;
+extern int a6_hfi_first;
+extern int a6_hfi_dump;
+extern int a6_fence_mode;
+extern int a6_gmu_clk_500;
+extern int a6_paint;		/* sweetgpupaint=1: CP_MEM_WRITE/CP_MEMCPY test */
+extern int a6_2d;		/* sweetgpu2d=1: 2D blit self-test */
+extern int a6_v2;		/* sweetgpu_v2=1: high-RAM BO self-test */
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa);
+int a6_power_up(struct a6_gpu *g);	/* CX+GMU+HFI+GX+CP; 0 = ok */
+int a6_selftest(struct a6_gpu *g);	/* ring a CP_MEM_WRITE; 0 = the value landed */
+int sweet_gpu_panel_probe(void);	/* environment: read-only DPU SSPP probe */
+void sweet_gpu_mem_probe(void);	/* environment: physmap coverage probe */
+int sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa);
+int sweet_gpu_v2_test(void);
+
+/* 2D blit engine (RB_A2D/GRAS_A2D/TPL1_A2D), after turnip's r2d path. */
+struct a6_blit {
+	uint64_t src_iova;
+	uint32_t src_w, src_h, src_pitch;
+	uint32_t sx, sy, sw, sh;	/* source rectangle */
+	uint64_t dst_iova;
+	uint32_t dst_pitch;		/* 64-byte units in the register */
+	uint32_t dx, dy, dw, dh;
+	bool filter;			/* bilinear */
+};
+uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw);
+int a6_blit_test(struct a6_gpu *g);
+bool a6_cx_up(void);
+bool a6_gx_up(void);
+bool a6_cp_running(const struct a6_gpu *g);
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt);
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt);
+
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms);
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms);
+uint32_t a6_fence_read(const struct a6_gpu *g);
+
+/* Build a 1:1 crop copy (CP_MEMCPY rows) from a surface IOVA to the panel
+ * into the pool at off; returns the dword count. */
+uint32_t a6_present_ib(struct a6_gpu *g, uint64_t off, uint64_t src, uint32_t sx, uint32_t sy,
+    uint32_t dx, uint32_t dy, uint32_t w, uint32_t h, uint32_t src_pitch, uint32_t dst_pitch);
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size);
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+void a6_unmap_high(struct a6_gpu *g);
+void a6_tlb_flush(const struct a6_gpu *g);
+int a6_clear_fault(const struct a6_gpu *g);
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0);
+
+#define A6_CP_NOP		0x10
+#define A6_CP_WAIT_FOR_IDLE	0x26
+#define A6_CP_BLIT		0x2c
+#define A6_CP_MEM_WRITE		0x3d
+#define A6_CP_INDIRECT_BUFFER	0x3f
+#define A6_CP_EVENT_WRITE	0x46
+#define A6_CP_ME_INIT		0x48
+#define A6_CP_SET_SECURE_MODE	0x66
+#define A6_CP_MEMCPY		0x75
+
+/* Register/state access for status and dumps */
+#define A6_GPU_BASE		0x05000000ull
+#define A6_GREG(o)		(A6_GPU_BASE + 4ull * (o))
+#define A6_GPUCC		0x05090000ull
+#define A6_SMMU			0x05040000ull
+#define A6_GMU			0x0506a000ull
+#define A6_SMMU_CB(n)		(A6_SMMU + 0x8000 + 0x1000ull * (n))
+#define A6_FSR_FAULT		0xc00001feu
+#define A6_GMEM_LOG_OFF		0x94000ull
+#define A6_GMU_LOG_VA		0x60001000u
+#define A6_GMU_LOG_SIZE		0x4000u
+
+#endif
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..3a939da
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,519 @@
+/*
+ * Adreno 630 (SDM845, polaris) in XNU: the environment for the shared core
+ * (sweet_a6xx.c), a kernel thread that runs the bring-up, and the SMC hook
+ * the zap shader needs.
+ *
+ * Boot arg sweetgpu=1 enables it.  Firmware comes in the device tree as
+ * /chosen properties "gpufw,<file>" (tools/mkpayload.py --gpufw DIR):
+ * a630_gmu.bin, a630_sqe.fw and a630_zap.mdt/.b02.
+ *
+ * The boot settle delay is a sleep-wait (thread_block); the register
+ * timeouts use short busy waits (delay) so they are safe while the GPU
+ * mutex is held.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include "sweet_a6xx.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int vprintf(const char *fmt, va_list ap);
+
+void sweet_gpu_init(void);
+bool sweet_gpu_ready(void);
+uint64_t sweet_gpu_pool_pa(void);
+int sweet_gpu_surface_slot(uint64_t key);
+int sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+int sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t sx, uint32_t sy,
+    uint32_t dx, uint32_t dy, uint32_t w, uint32_t h, uint32_t src_pitch, uint32_t dst_pitch);
+int sweet_gpu_panel_probe(void);
+
+static struct a6_gpu gpu;
+static vm_offset_t pool_kva;
+static volatile bool gpu_ready;
+static int gpu_sleep_chan;
+int a6_stage_limit = 99;
+int a6_hfi_table_size_dw = 42;
+int a6_hfi_layout = 1;
+int a6_hfi_base_mode = 1;
+int a6_hfi_qids = 0;
+int a6_hfi_first = 0;
+int a6_hfi_dump = 0;
+int a6_fence_mode = 0;
+int a6_gmu_clk_500 = 0;
+int a6_paint = 0;
+int a6_2d = 0;
+int a6_v2 = 0;
+static LCK_GRP_DECLARE(sweet_gpu_grp, "sweet_gpu");
+static LCK_MTX_DECLARE(sweet_gpu_lock, &sweet_gpu_grp);
+
+/* ---- environment for sweet_a6xx.c ---- */
+
+#define GPU_WIN		0x200000ULL
+#define GPU_MAPS	24
+
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} gpu_map[GPU_MAPS];
+
+/* Device windows (2 MB, kept for good: only a handful of register blocks). */
+static volatile uint32_t *
+gpu_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(GPU_WIN - 1);
+	for (unsigned i = 0; i < GPU_MAPS; i++) {
+		if (gpu_map[i].va && gpu_map[i].win == win)
+			return (volatile uint32_t *)(gpu_map[i].va + (pa - win));
+		if (!gpu_map[i].va) {
+			gpu_map[i].va = ml_io_map_unmappable((vm_offset_t)win, GPU_WIN, VM_WIMG_IO);
+			gpu_map[i].win = win;
+			return gpu_map[i].va ? (volatile uint32_t *)(gpu_map[i].va + (pa - win)) : NULL;
+		}
+	}
+	panic("sweet_gpu: out of device windows at 0x%llx", pa);
+}
+
+static bool
+in_pool(uint64_t pa, size_t len)
+{
+	return pool_kva && pa >= gpu.pool_pa && pa + len <= gpu.pool_pa + A6_POOL_SIZE;
+}
+
+uint32_t
+a6_rd(uint64_t pa)
+{
+	uint32_t v;
+	if (in_pool(pa, 4)) {
+		(void)a6_read(pa, &v, 4);
+		return v;
+	}
+	if (pmap_valid_address(pa)) {
+		flush_dcache64((addr64_t)pa, 4, TRUE);
+		return *(volatile uint32_t *)phystokv(pa);
+	}
+	v = *gpu_io(pa);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+a6_wr(uint64_t pa, uint32_t v)
+{
+	if (in_pool(pa, 4) || pmap_valid_address(pa)) {
+		(void)a6_write(pa, &v, 4);
+		return;
+	}
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*gpu_io(pa) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Pool: through its kernel mapping (no cache aliases). RAM: the physmap. MMIO: words. */
+int
+a6_write(uint64_t pa, const void *buf, size_t len)
+{
+	if (in_pool(pa, len)) {
+		memcpy((void *)(pool_kva + (pa - gpu.pool_pa)), buf, len);
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		return 0;
+	}
+	if (pmap_valid_address(pa)) {
+		memcpy((void *)phystokv(pa), buf, len);
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		return 0;
+	}
+	const uint32_t *w = buf;
+	for (size_t i = 0; i < len / 4; i++)
+		a6_wr(pa + 4 * i, w[i]);
+	return 0;
+}
+
+int
+a6_read(uint64_t pa, void *buf, size_t len)
+{
+	if (in_pool(pa, len)) {
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		memcpy(buf, (const void *)(pool_kva + (pa - gpu.pool_pa)), len);
+		return 0;
+	}
+	if (pmap_valid_address(pa)) {
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		memcpy(buf, (const void *)phystokv(pa), len);
+		return 0;
+	}
+	uint32_t *w = buf;
+	for (size_t i = 0; i < len / 4; i++)
+		w[i] = a6_rd(pa + 4 * i);
+	return 0;
+}
+
+void
+a6_delay_ms(unsigned ms)
+{
+	delay((int)ms * 1000);
+}
