+static const uint32_t gpu_khz[] = { 257000, 342000, 414000, 520000, 596000, 675000, 710000 };
+static const uint32_t gpu_lvl[] = { LVL_LOW_SVS, LVL_SVS, LVL_SVS_L1, LVL_SVS_L2, LVL_NOM, LVL_NOM_L2,
