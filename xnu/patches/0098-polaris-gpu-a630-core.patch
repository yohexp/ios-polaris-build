+++ b/bsd/dev/sweet_a6xx.c
@@ -0,0 +1,1804 @@
+/*
+ * Adreno 630 (SDM845, polaris) core.  See sweet_a6xx.h for the pool layout
+ * and the a630-specific deltas.
+ *
+ * Bring-up order (mainline a6xx):
+ *   1. CX clocks/GDSC, GPUCC.
+ *   2. GMU SMMU stream 5, HFI queues, RSC/PDC ucode, a630_gmu.bin into ITCM,
+ *      CM3 reset release, FW_INIT_RESULT == 0xbabeface.
+ *   3. OOB BOOT_SLUMBER -> GX rail, SPTPRAC, HFI init.
+ *   4. Legacy HFI v1: INIT, FW_VERSION, PERF_TABLE, BW_TABLE, TEST, vote.
+ *   5. OOB GPU_SET, a630 hw_init subset, SQE, ring, CP_ME_INIT, zap,
+ *      CP_SET_SECURE_MODE 0, then a CP_MEM_WRITE self-test.
+ */
+#if !defined(KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET)
+#ifdef KERNEL
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <kern/sched_prim.h>
+#else
+#include <string.h>
+#endif
+#include "sweet_a6xx.h"
+
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+
+#define rd32		a6_rd
+#define wr32		a6_wr
+
+static void wr64(uint64_t pa, uint64_t v)
+{
+	wr32(pa, (uint32_t)v);
+	wr32(pa + 4, (uint32_t)(v >> 32));
+}
+
+static int wait_bit(uint64_t pa, uint32_t mask, int set, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms; i++) {
+		if (!!(rd32(pa) & mask) == set)
+			return 0;
+		if (i < ms)
+			a6_delay_ms(1);
+	}
+	return -1;
+}
+
+static void zero_pa(uint64_t pa, uint64_t size)
+{
+	static const uint8_t z[0x4000];
+	for (uint64_t o = 0; o < size; o += sizeof(z))
+		a6_write(pa + o, z, (size_t)(size - o < sizeof(z) ? size - o : sizeof(z)));
+}
+
+/* ---- registers ---- */
+
+#define GCC		0x00100000ull
+#define GPUCC		A6_GPUCC
+#define GPU		A6_GPU_BASE
+#define GREG(o)		A6_GREG(o)
+#define GMU_REG(o)	A6_GREG(o)
+#define SMMU		A6_SMMU
+
+#define GPUCC_CX_GDSCR	0x106c
+#define GPUCC_GX_GDSCR	0x100c
+#define GPUCC_GMU_RCG	0x1120
+#define GPUCC_AHB	0x107c
+#define GPUCC_CXO	0x109c
+#define GPUCC_CX_GMU	0x1098
+
+/* Fabia PLL1 (gpu_cc_pll1, offset 0x100).  Register layout differs from
+ * the plain Alpha PLL: user ctl lo is 0xc, frac 0x38, opmode 0x2c. */
+#define GPUCC_PLL1	0x0100
+#define PLL_MODE	0x00
+#define PLL_L_VAL	0x04
+#define FABIA_USER_CTL_LO 0x0c
+#define FABIA_OPMODE	0x2c
+#define FABIA_FRAC_VAL	0x38
+#define PLL_OUTCTRL	(1u << 0)
+#define PLL_RESET_N	(1u << 2)
+#define PLL_VOTE_FSM_ENA (1u << 20)
+#define PLL_HW_UPDATE_LOGIC_BYPASS (1u << 23)
+#define PLL_ACTIVE_FLAG	(1u << 30)
+#define PLL_LOCK_DET	(1u << 31)
+#define FABIA_PLL_OUT_MASK 0x7u
+#define PLL1_L_VAL	0x1a		/* 19.2 MHz * 26.6667 = 512 MHz */
+#define PLL1_FRAC_VAL	0xaaaa
+
+#define GMU_ITCM	0x1b400
+#define GMU_DTCM	0x1c400
+#define GMU_FW_VERSION	0x1d3f8
+#define GMU_INIT_RESULT	0x1f81c
+#define GMU_RPMH_STATE	0x1f8ec
+#define GMU_GENERAL_7	0x1f9cc
+#define GMU_CX_BUSY	0x23b0c
