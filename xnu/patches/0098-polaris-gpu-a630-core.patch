+
+void
+a6_smc(uint64_t x[8])
+{
+	register uint64_t x0 __asm__("x0") = x[0];
+	register uint64_t x1 __asm__("x1") = x[1];
+	register uint64_t x2 __asm__("x2") = x[2];
+	register uint64_t x3 __asm__("x3") = x[3];
+	register uint64_t x4 __asm__("x4") = x[4];
+	register uint64_t x5 __asm__("x5") = x[5];
+	register uint64_t x6 __asm__("x6") = x[6];
+	register uint64_t x7 __asm__("x7") = x[7];
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+	    :
+	    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	x[0] = x0;
+	x[1] = x1;
+	x[2] = x2;
+	x[3] = x3;
+	x[6] = x6;		/* ARM_SMCCC_QUIRK_QCOM_A6 resume token */
+}
+
+const uint8_t *
+a6_firmware(const char *name, uint32_t *len)
+{
+	DTEntry chosen;
+	void const *data;
+	unsigned size;
+	char prop[40];
+	snprintf(prop, sizeof(prop), "gpufw,%s", name);
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, prop, &data, &size) != kSuccess) {
+		a6_log("no firmware %s in the device tree (mkpayload.py --gpufw)\n", name);
+		return NULL;
+	}
+	*len = size;
+	return data;
+}
+
+/* ---- bring-up ---- */
+
+/* Boot settle delay: sleep before taking the GPU mutex. */
+static void
+gpu_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gpu_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t delay_s = 3;
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	if (delay_s)
+		gpu_sleep_ms(delay_s * 1000u);
+
+	uint64_t t0 = mach_absolute_time(), ns;
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_power_up(&gpu);
+	if (!rc)
+		gpu_ready = true;
+	lck_mtx_unlock(&sweet_gpu_lock);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	a6_log("bring-up %s in %llu ms (pool 0x%llx)\n", rc ? "FAILED" : "done, GPU ready",
+	    (unsigned long long)(ns / 1000000), (unsigned long long)gpu.pool_pa);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_init(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetgpu", &on, sizeof(on));
+	if (!on)
+		return;
+	(void)PE_parse_boot_argn("sweetgpustage", &a6_stage_limit, sizeof(a6_stage_limit));
+	(void)PE_parse_boot_argn("sweetgpuhfitbl", &a6_hfi_table_size_dw, sizeof(a6_hfi_table_size_dw));
+	(void)PE_parse_boot_argn("sweetgpuhfilayout", &a6_hfi_layout, sizeof(a6_hfi_layout));
+	(void)PE_parse_boot_argn("sweetgpuhfibase", &a6_hfi_base_mode, sizeof(a6_hfi_base_mode));
+	(void)PE_parse_boot_argn("sweetgpuhfiqids", &a6_hfi_qids, sizeof(a6_hfi_qids));
+	(void)PE_parse_boot_argn("sweetgpuhfifirst", &a6_hfi_first, sizeof(a6_hfi_first));
+	(void)PE_parse_boot_argn("sweetgpuhfidump", &a6_hfi_dump, sizeof(a6_hfi_dump));
+	(void)PE_parse_boot_argn("sweetgpufence", &a6_fence_mode, sizeof(a6_fence_mode));
+	(void)PE_parse_boot_argn("sweetgpugmuclk", &a6_gmu_clk_500, sizeof(a6_gmu_clk_500));
+	(void)PE_parse_boot_argn("sweetgpupaint", &a6_paint, sizeof(a6_paint));
+	(void)PE_parse_boot_argn("sweetgpu2d", &a6_2d, sizeof(a6_2d));
+	(void)PE_parse_boot_argn("sweetgpu_v2", &a6_v2, sizeof(a6_v2));
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, A6_POOL_SIZE, PAGE_MASK, 0, (ppnum_t)(atop_64(A6_POOL_ALIGN) - 1),
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		a6_log("no contiguous pool\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	a6_init_state(&gpu, ptoa_64(pn));
+	pool_kva = va;
+	flush_dcache64((addr64_t)gpu.pool_pa, (unsigned)A6_POOL_SIZE, TRUE);
+	thread_t thread;
+	if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS)
+		thread_deallocate(thread);
+}
