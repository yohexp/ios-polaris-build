+/* _load_gmu_rpmh_ucode() for a630: RSC in the GMU block, PDC at 0xb200000. */
+static void rpmh_init(void)
+{
+	static const uint32_t rsc[][2] = {
+		{ A6XX_GPU_RSCC_RSC_STATUS0_DRV0, 1u << 24 },
+		{ A6XX_RSCC_PDC_SLAVE_ID_DRV0, 1 },
+		{ A6XX_RSCC_HIDDEN_TCS_CMD0_DATA, 0 },
+		{ A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR, 0 },
+		{ A6XX_RSCC_HIDDEN_TCS_CMD0_DATA + 2, 0 },
+		{ A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 2, 0 },
+		{ A6XX_RSCC_HIDDEN_TCS_CMD0_DATA + 4, 0x80000000 },
+		{ A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 4, 0 },
+		{ A6XX_RSCC_OVERRIDE_START_ADDR, 0 },
+		{ A6XX_RSCC_PDC_SEQ_START_ADDR, 0x4520 },
+		{ A6XX_RSCC_PDC_MATCH_VALUE_LO, 0x4510 },
+		{ A6XX_RSCC_PDC_MATCH_VALUE_HI, 0x4514 },
+		{ A6XX_RSCC_SEQ_MEM_0_DRV0 + 0, 0xa7a506a0 },
+		{ A6XX_RSCC_SEQ_MEM_0_DRV0 + 1, 0xa1e6a6e7 },
+		{ A6XX_RSCC_SEQ_MEM_0_DRV0 + 2, 0xa2e081e1 },
+		{ A6XX_RSCC_SEQ_MEM_0_DRV0 + 3, 0xe9a982e2 },
+		{ A6XX_RSCC_SEQ_MEM_0_DRV0 + 4, 0x0020e8a8 },
+	};
+	static const uint32_t seq[] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	static const uint32_t tcs1[][2] = {
+		{ PDC_GPU_TCS1_CMD_ENABLE_BANK, 7 }, { PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK, 0 },
+		{ PDC_GPU_TCS1_CONTROL, 0 }, { PDC_GPU_TCS1_CMD0_MSGID, 0x10108 },
+		{ PDC_GPU_TCS1_CMD0_ADDR, 0x30010 }, { PDC_GPU_TCS1_CMD0_DATA, 1 },
+		{ PDC_GPU_TCS1_CMD0_MSGID + PDC_CMD_OFFSET, 0x10108 },
+		{ PDC_GPU_TCS1_CMD0_ADDR + PDC_CMD_OFFSET, 0x30000 },
+		{ PDC_GPU_TCS1_CMD0_DATA + PDC_CMD_OFFSET, 0 },
+		{ PDC_GPU_TCS1_CMD0_MSGID + 2 * PDC_CMD_OFFSET, 0x10108 },
+		{ PDC_GPU_TCS1_CMD0_ADDR + 2 * PDC_CMD_OFFSET, 0x30080 },
+		{ PDC_GPU_TCS1_CMD0_DATA + 2 * PDC_CMD_OFFSET, 0 },
+	};
+	static const uint32_t tcs3[][2] = {
+		{ PDC_GPU_TCS3_CMD_ENABLE_BANK, 7 }, { PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK, 0 },
+		{ PDC_GPU_TCS3_CONTROL, 0 }, { PDC_GPU_TCS3_CMD0_MSGID, 0x10108 },
+		{ PDC_GPU_TCS3_CMD0_ADDR, 0x30010 }, { PDC_GPU_TCS3_CMD0_DATA, 2 },
+		{ PDC_GPU_TCS3_CMD0_MSGID + PDC_CMD_OFFSET, 0x10108 },
+		{ PDC_GPU_TCS3_CMD0_ADDR + PDC_CMD_OFFSET, 0x30000 },
+		{ PDC_GPU_TCS3_CMD0_DATA + PDC_CMD_OFFSET, 3 },
+		{ PDC_GPU_TCS3_CMD0_MSGID + 2 * PDC_CMD_OFFSET, 0x10108 },
+		{ PDC_GPU_TCS3_CMD0_ADDR + 2 * PDC_CMD_OFFSET, 0x30080 },
+		{ PDC_GPU_TCS3_CMD0_DATA + 2 * PDC_CMD_OFFSET, 3 },
+	};
+	for (unsigned i = 0; i < sizeof(rsc) / sizeof(rsc[0]); i++)
+		wr32(GMU_REG(rsc[i][0]), rsc[i][1]);
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); i++)
+		wr32(PDC_REG(PDC_GPU_SEQ_MEM_0 + i), seq[i]);
+	for (unsigned i = 0; i < sizeof(tcs1) / sizeof(tcs1[0]); i++)
+		wr32(PDC_REG(tcs1[i][0]), tcs1[i][1]);
+	for (unsigned i = 0; i < sizeof(tcs3) / sizeof(tcs3[0]); i++)
+		wr32(PDC_REG(tcs3[i][0]), tcs3[i][1]);
+	wr32(PDC_REG(PDC_GPU_SEQ_START_ADDR), 0);
+	wr32(PDC_REG(PDC_GPU_ENABLE_PDC), 0x80000001);
+}
+
+static void hfi_table(struct a6_gpu *g)
+{
+	static const uint32_t ids_legacy[3] = { 0, 4, 5 };
+	static const uint32_t ids_new[3] = { 0, 1, 2 };
+	static const uint32_t prio_legacy[3] = { 10, 10, 40 };
+	static const uint32_t prio_new[3] = { 10, 10, 10 };
+	const uint32_t *ids = a6_hfi_qids ? ids_new : ids_legacy;
+	const uint32_t *prio = a6_hfi_qids ? prio_new : prio_legacy;
+	uint64_t t = GMEM_HFI(g);
+	wr32(t + 0, 0);
+	wr32(t + 4, (uint32_t)a6_hfi_table_size_dw);	/* vendor hfi_init says 42 dwords */
+	wr32(t + 8, 6);
+	wr32(t + 12, 12);
+	wr32(t + 16, 3);
+	wr32(t + 20, 3);
+	for (uint32_t q = 0; q < 3; q++) {
+		uint64_t h = t + 24 + 48 * q;
+		wr32(h + 0, 1);
+		wr32(h + 4, g->va_hfi + (a6_hfi_layout ? HFI_Q0_OFF + q * HFI_QSTRIDE : 0x1000 * (q + 1)));
+		wr32(h + 8, ids[q] | (prio[q] << 8));
+		wr32(h + 12, 0x1000 >> 2);
+		wr32(h + 16, 0);
+		wr32(h + 20, 0);
+		wr32(h + 24, 1);
+		wr32(h + 28, 1);
+		wr32(h + 32, 1);
+		wr32(h + 36, 0);
+		wr32(h + 40, 0);
+		wr32(h + 44, 0);
+	}
+}
+
+/*
+ * a630_gmu.bin is a raw Thumb image (the a640 file is a 16-byte-header block
+ * list).  Legacy TCM boot: every dword goes to CM3 ITCM over AHB.
+ */
+static int fw_load(struct a6_gpu *g)
+{
+	uint32_t len;
+	(void)g;
+	const uint8_t *fw = a6_firmware("a630_gmu.bin", &len);
+	if (!fw)
+		return -1;
+	if (len > 0x8000) {
+		a6_log("gmu fw: %u bytes does not fit ITCM\n", len);
+		return -1;
+	}
+	a6_write(GMU_REG(GMU_ITCM), fw, (len + 3) & ~3u);
+	a6_log("gmu: %u bytes of a630_gmu.bin into ITCM\n", len);
+	return 1;
+}
+
+static int gmu_boot(struct a6_gpu *g)
+{
+	/* Hold the CM3 in reset while we reprogram its SMMU, RSC and ITCM. */
+	stage("gmu smmu (cm3 reset)");
+	wr32(GMU_REG(GMU_SYSRESET), 1);
+	if (gmu_smmu(g))
+		return -1;
+	wr32(GMU_REG(GMU_GENERAL_7), 1);		/* TCM retention */
+	stage("rsc/pdc");
+	rpmh_init();
+	hfi_table(g);
+
+	stage("gmu itcm");
+	int nblk = fw_load(g);
+	if (nblk <= 0)
+		return -1;
+
+	wr32(GMU_REG(GMU_INIT_RESULT), 0);
+	wr32(GMU_REG(GMU_BOOT_CFG), 2);			/* TCM boot */
+	wr32(GMU_REG(GMU_QTBL_ADDR), g->va_hfi);
+	wr32(GMU_REG(GMU_QTBL_INFO), 1);
+		uint32_t fence = a6_fence_mode ? 0x802800A0u : 0x80A008A0u;	/* mainline / vendor */
+	wr32(GMU_REG(GMU_FENCE0), fence);
+	wr32(GMU_REG(GMU_CM3_CFG), 0x4052);
+	wr32(GMU_REG(GMU_SFR_ADDR), A6_GMU_CHIP_ID);
+	wr32(GMU_REG(GMU_CP_MSG), g->va_log | (A6_GMU_LOG_SIZE / 0x1000 - 1));
+	wr32(GMU_REG(GMU_SYS_BUS), 1);
+	wr32(GMU_REG(GMU_ICACHE_CFG), 1);
+	wr32(GMU_REG(GMU_DCACHE_CFG), 1);
+	wr32(GMU_REG(GMU_PWRCOL_CTRL), 0x9c40400);
+	wr32(GMU_REG(GMU_RPMH_CTRL), rd32(GMU_REG(GMU_RPMH_CTRL)) |
+	     1 | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
+	wr32(GMU_REG(GMU_WFI_CONFIG), 0);
+	a6_log("gmu cfg: boot %x qtbl %x/%x fence %x sf %x cm3 %x wfi %x rpmh %x ic %x dc %x cpmsg %x\n",
+	       rd32(GMU_REG(GMU_BOOT_CFG)), rd32(GMU_REG(GMU_QTBL_ADDR)),
+	       rd32(GMU_REG(GMU_QTBL_INFO)), rd32(GMU_REG(GMU_FENCE0)),
+	       rd32(GMU_REG(GMU_SFR_ADDR)), rd32(GMU_REG(GMU_CM3_CFG)),
+	       rd32(GMU_REG(GMU_WFI_CONFIG)), rd32(GMU_REG(GMU_RPMH_CTRL)),
+	       rd32(GMU_REG(GMU_ICACHE_CFG)), rd32(GMU_REG(GMU_DCACHE_CFG)),
+	       rd32(GMU_REG(GMU_CP_MSG)));
+
+	uint32_t v = rd32(GMU_REG(GMU_DTCM) + 0xff8 * 4);
+	uint32_t mask = v <= 0x20010004 ? 0xffffffff : 0x1ff;
+	uint32_t want = v <= 0x20010004 ? 0xbabeface : 0x100;
+	wr32(GMU_REG(GMU_SYSRESET), 1);
+	wr32(GMU_REG(GMU_CP_RESP), 0);
+	wr32(GMU_REG(GMU_SYSRESET), 0);
+	uint32_t r = 0;
+	bool ok = false;
+	for (int i = 0; i < 2000 && !ok; i++) {
+		r = rd32(GMU_REG(GMU_INIT_RESULT));
+		ok = (r & mask) == want;
+		if (!ok)
+			a6_delay_ms(1);
+	}
+	a6_log("gmu: dtcm sentinel %x, init result %x %s, hfi_ctrl %x\n", v, r, ok ? "BOOTED" : "timeout",
+	       rd32(GMU_REG(GMU_HFI_CTRL)));
+	return ok ? 0 : -1;
+}
+
+/* ---- stage 3: HFI, GX power ---- */
+
+#define HFI_Q_CMD	0
+#define HFI_Q_RESP	1
+#define QHDR(g, q)	(GMEM_HFI(g) + 24 + 48 * (q))
+static uint64_t hfi_qdata(struct a6_gpu *g, int q)
+{
+	if (a6_hfi_layout)
+		return GMEM_HFI(g) + HFI_Q0_OFF + (uint32_t)q * HFI_QSTRIDE;
+	return GMEM_HFI(g) + 0x1000 * ((uint32_t)q + 1);
+}
+#define QSIZE		1024
