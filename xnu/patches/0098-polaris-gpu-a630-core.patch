+sweet_gpu_pool_pa(void)
+{
+	return gpu.pool_pa;
+}
+
+/* Read-only: which physical ranges are outside XNU's physmap (candidates for
+ * the v2 write-combined buffer pool). */
+void
+sweet_gpu_mem_probe(void)
+{
+	static const uint64_t pa[] = {
+		0x80000000ull, 0x8ab00000ull, 0x8c500000ull, 0x8e400000ull,
+		0x95c00000ull, 0x96100000ull, 0x96900000ull, 0x96b00000ull,
+		0x9d400000ull, 0xaf000000ull, 0xb0000000ull, 0xc0000000ull,
+		0xc4000000ull, 0xe0000000ull, 0xe1000000ull, 0xf0000000ull,
+		0x100000000ull, 0x140000000ull, 0x180000000ull,
+	};
+	for (unsigned i = 0; i < sizeof(pa) / sizeof(pa[0]); i++) {
+		a6_log("mem: %llx physmap %d\n", (unsigned long long)pa[i],
+		       pmap_valid_address(pa[i]));
+	}
+}
+
+/* Read-only probe of the SDE/DPU SSPP source address and row stride (panel
+ * fetch).  It tells us which pipe the ABL left scanning and whether a
+ * 64-byte-aligned stride (for the 2D blit engine) is reachable. */
+int
+sweet_gpu_panel_probe(void)
+{
+	static const uint32_t off[] = {
+		0x5000, 0x7000, 0x9000, 0xb000,
+		0x25000, 0x27000, 0x29000, 0x2b000,
+	};
+	int hit = -1;
+	for (unsigned i = 0; i < sizeof(off) / sizeof(off[0]); i++) {
+		uint64_t b = 0x0ae00000ull + off[i];
+		uint32_t addr = a6_rd(b + 0x14), stride = a6_rd(b + 0x24);
+		if (addr || stride) {
+			a6_log("sspp%u off %x src0 %x ystride %x\n", i, off[i], addr, stride);
+		}
+		if (addr == (uint32_t)A6_FB_PA) {
+			hit = (int)i;
+		}
+	}
+	a6_log("panel probe: active sspp %d\n", hit);
+	return hit;
+}
+
+/* ---- v2 buffer pool (RAM XNU does not map) and self-test ---- */
+
+/* ADT dram-size is 1.23 GB from 0xb0000000 (XNU's physmap); the DT's second
+ * memory region at 5 GB (0x140000000, 3 GB) is general DRAM outside it.  Use
+ * the first 512 MB for write-combined GPU buffers (no physmap alias). */
+#define GPOOL_BASE	0x140000000ull
+#define GPOOL_LIMIT	0x160000000ull
+static uint64_t gpool_next = GPOOL_BASE;
+
+int
+sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa)
+{
+	uint64_t size = (bytes + 0x3fffull) & ~0x3fffull;
+	if (size == 0 || gpool_next + size > GPOOL_LIMIT) {
+		return -1;
+	}
+	*pa = gpool_next;
+	gpool_next += size;
+	return 0;
+}
+
+/* Allocate a BO above 4 GB, write an IB into it through an uncached I/O map,
+ * map it at a 4 GB GPU window and submit.  Proves the v2 memory model. */
+int
+sweet_gpu_v2_test(void)
+{
+	uint64_t bo_pa = 0, iova = 0x1000000000ull;
+	if (sweet_gpu_pool_alloc(0x10000, &bo_pa)) {
+		a6_log("v2: pool exhausted\n");
+		return -1;
+	}
+	vm_offset_t bo_va = ml_io_map_unmappable((vm_offset_t)bo_pa, 0x10000, VM_WIMG_IO);
+	if (!bo_va) {
+		a6_log("v2: no I/O map for %llx\n", (unsigned long long)bo_pa);
+		return -1;
+	}
+	volatile uint32_t *bo = (volatile uint32_t *)bo_va;
+	for (unsigned i = 0; i < 0x10000 / 4; i++) {
+		bo[i] = 0xdeadbeef;
+	}
+	uint32_t *dw = (uint32_t *)bo;
+	uint64_t tva = a6_pool_va(A6_OFF_SCRATCH + 0x200);
+	uint32_t n = 0;
+	dw[n++] = a6_pkt7(A6_CP_MEM_WRITE, 3);
+	dw[n++] = (uint32_t)tva;
+	dw[n++] = (uint32_t)(tva >> 32);
+	dw[n++] = 0xcafef00d;
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t pages[4] = { bo_pa, bo_pa + 0x4000, bo_pa + 0x8000, bo_pa + 0xc000 };
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_map_pages(&gpu, iova, pages, 4, 0x4000);
+	a6_tlb_flush(&gpu);
+	if (!rc) {
+		rc = a6_submit_ib(&gpu, iova, n, 1000);
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	uint32_t got = 0;
+	a6_read(a6_pool_pa(&gpu, A6_OFF_SCRATCH + 0x200), &got, 4);
+	a6_log("v2: bo %llx iova %llx submit %d mem %x %s\n", (unsigned long long)bo_pa,
+	       (unsigned long long)iova, rc, got, got == 0xcafef00d ? "ok" : "FAILED");
+	ml_io_unmap(bo_va, 0x10000);
+	return rc || got != 0xcafef00d ? -1 : 0;
+}
+
+/* ---- panel present (SweetFramebuffer.cpp, boot-arg sweetfbgpu=1) ---- */
+
+#define SLOTS		4
+#define SLOT_IOVA(n)	(0x100000000ULL + 0x1000000ULL * (n))
+#define SLOT_MAX	0x1000000ULL
+#define SLOT_PAGES	1024		/* 16 KB pages: 16 MB */
+
+static struct {
+	uint64_t key;
+	uint32_t npages, page_size;
+	uint64_t used;
+} slot[SLOTS];
+static uint64_t slot_clock;
+
+int
+sweet_gpu_surface_slot(uint64_t key)
+{
+	for (int i = 0; i < SLOTS; i++) {
+		if (slot[i].key == key && slot[i].npages) {
+			slot[i].used = ++slot_clock;
+			return i;
+		}
+	}
+	return -1;
+}
+
+int
+sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	if (!gpu_ready || npages == 0 || npages > SLOT_PAGES ||
+	    (uint64_t)npages * page_size > SLOT_MAX) {
+		return -1;
+	}
+	int s = 0;
+	for (int i = 1; i < SLOTS; i++) {
+		if (slot[i].used < slot[s].used) {
+			s = i;
+		}
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_map_pages(&gpu, SLOT_IOVA(s), pages, npages, page_size);
+	a6_tlb_flush(&gpu);
+	lck_mtx_unlock(&sweet_gpu_lock);
+	if (rc) {
+		slot[s].npages = 0;
+		return -1;
+	}
+	slot[s].npages = npages;
+	slot[s].page_size = page_size;
+	slot[s].key = key;
+	slot[s].used = ++slot_clock;
+	a6_log("surface %llx -> slot %d (%u x %u)\n", key, s, npages, page_size);
+	return s;
+}
+
+static uint64_t stat_present, stat_clean, stat_copy;
+
+int
+sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t sx, uint32_t sy,
+    uint32_t dx, uint32_t dy, uint32_t w, uint32_t h, uint32_t src_pitch, uint32_t dst_pitch)
+{
+	if (!gpu_ready || s < 0 || s >= SLOTS || !slot[s].npages || w == 0 || h == 0) {
+		return -1;
+	}
+	a6_log("present: start s%d %ux%u +%u,%u -> +%u,%u pitch %u->%u kva %llx\n", s, w, h,
+	    sx, sy, dx, dy, src_pitch, dst_pitch, (unsigned long long)kva);
+	uint64_t t0 = mach_absolute_time();
+	if (kva) {
+		clean_dcache64((addr64_t)kva, (unsigned)((uint64_t)src_pitch * h + offset), FALSE);
+	}
+	uint64_t t1 = mach_absolute_time();
+	a6_log("present: cache cleaned\n");
+	lck_mtx_lock(&sweet_gpu_lock);
+	uint32_t n = a6_present_ib(&gpu, A6_OFF_PRESENT, SLOT_IOVA(s) + offset, sx, sy, dx, dy,
+	    w, h, src_pitch, dst_pitch);
+	a6_log("present: ib %u dwords at %llx, submitting\n", n,
+	    (unsigned long long)a6_pool_va(A6_OFF_PRESENT));
+	int rc = a6_submit_ib(&gpu, a6_pool_va(A6_OFF_PRESENT), n, 200);
+	a6_log("present: submit rc %d\n", rc);
+	if (rc) {
+		uint64_t far;
+		uint32_t syn, fsr = a6_fault_status(&gpu, &far, &syn);
+		a6_log("present: timeout (%u rows, smmu fsr %x far %llx); CPU copy\n", h, fsr, far);
+		(void)a6_clear_fault(&gpu);
+		gpu_ready = false;
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	uint64_t t2 = mach_absolute_time();
+	stat_clean += t1 - t0;
+	stat_copy += t2 - t1;
+	uint64_t cn, gn;
+	absolutetime_to_nanoseconds(t1 - t0, &cn);
+	absolutetime_to_nanoseconds(t2 - t1, &gn);
+	if (stat_present <= 8) {
+		a6_log("present: frame %llu clean %llu us copy %llu us\n", stat_present,
+		    cn / 1000, gn / 1000);
+	}
+	if ((stat_present % 20) == 0) {
+		uint64_t c, g;
+		absolutetime_to_nanoseconds(stat_clean, &c);
+		absolutetime_to_nanoseconds(stat_copy, &g);
+		a6_log("present: %llu frames, avg clean %llu us, GPU copy %llu us\n", stat_present,
+		    c / 1000 / 20, g / 1000 / 20);
+		stat_clean = stat_copy = 0;
+	}
+	return rc;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
