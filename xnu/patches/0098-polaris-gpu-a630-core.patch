+static void hfi_dump(struct a6_gpu *g)
+{
+	a6_log("hfi tbl:");
+	for (unsigned i = 0; i < 24; i++)
+		a6_log(" %x", rd32(GMEM_HFI(g) + 4 * i));
+	a6_log("\nhfi q0:");
+	for (unsigned i = 0; i < 12; i++)
+		a6_log(" %x", rd32(hfi_qdata(g, HFI_Q_CMD) + 4 * i));
+	a6_log("\n");
+}
