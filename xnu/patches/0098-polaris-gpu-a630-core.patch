+#define GMEM_L1(g)	a6_pool_pa(g, 0x0000)
+#define GMEM_L2_0(g)	a6_pool_pa(g, 0x1000)
+#define GMEM_L2_1(g)	a6_pool_pa(g, 0x2000)
+#define GMEM_L3_LOW(g)	a6_pool_pa(g, 0x3000)
+#define GMEM_L3_6(g)	a6_pool_pa(g, 0x4000)
+#define GMEM_ICACHE(g)	a6_pool_pa(g, 0x10000)
+#define GMEM_DCACHE(g)	a6_pool_pa(g, 0x50000)
+#define GMEM_DUMMY(g)	a6_pool_pa(g, 0x90000)
+#define GMEM_LOG(g)	a6_pool_pa(g, A6_GMEM_LOG_OFF)
+#define GMEM_HFI(g)	a6_pool_pa(g, 0x98000)
+
+#define VA_ICACHE	0x4000u
+#define VA_DCACHE	0x44000u
+#define CACHE_SIZE	0x3c000u
+#define VA_DUMMY	0x60000000u
+#define VA_LOG		A6_GMU_LOG_VA
+#define VA_HFI		0x60005000u
+#define HFI_Q0_OFF	0x0a8u		/* sizeof(struct hfi_queue_table) */
+#define HFI_QSTRIDE	(0x1000u + 0x10u)	/* 4K queue + 16B guard */
+
+/* a630: RSC/RPMh registers are inside the GMU block, PDC is AOSS at 0xb200000. */
+#define PDC		0x0b200000ull
+#define PDC_REG(o)	(PDC + 4ull * (o))
+
+#define GMU_SYSRESET	0x1f800
+#define GMU_WFI_CONFIG	0x1f802
+#define GMU_BOOT_CFG	0x1f801
+#define GMU_CM3_CFG	0x1f82d
+#define GMU_PWRCOL_CTRL	0x1f8c0
+#define GMU_RPMH_CTRL	0x1f8e8
+#define GMU_CP_MSG	0x1f900
+#define GMU_CP_RESP	0x1f901
+#define GMU_HFI_CTRL	0x1f980		/* HFI_CTRL_STATUS */
+#define GMU_HFI_CTRL_INIT 0x1f986		/* write 1 to start HFI */
+#define GMU_SFR_ADDR	0x1f982
+#define GMU_QTBL_INFO	0x1f984
+#define GMU_QTBL_ADDR	0x1f985
+#define GMU_SYS_BUS	0x1f40f
+#define GMU_ICACHE_CFG	0x1f400
+#define GMU_DCACHE_CFG	0x1f401
+#define GMU_G2H_CLR	0x1f991
+#define GMU_G2H_INFO	0x1f992
+#define GMU_G2H_MASK	0x1f993
+#define GMU_H2G_RAW	0x1f996
+#define GMU_H2G_EN0	0x1f997
+#define GMU_H2G_EN1	0x1f998
+#define GMU_H2G_EN2	0x1f999
+#define GMU_H2G_EN3	0x1f99a
+#define GMU_AO_HOST_INTERRUPT_CLR	0x23b04
+#define GMU_AO_HOST_INTERRUPT_MASK	0x23b06
+#define GMU_AO_HOST_INTERRUPT_STATUS	0x23b05
+#define GMU_AHB_FENCE_CTRL	0x23b10
+#define GMU_AHB_FENCE_STATUS	0x23b13
+#define GMU_RBBM_INT_UNMASKED_STATUS	0x23b15
+#define GMU_H2G_SET	0x1f994
+#define GMU_HFI_CTRL_STATUS 0x1f980
+#define GMU_SPTPRAC_PWR_CLK_STATUS 0x1f8d0
+#define GMU_GX_SPTPRAC_POWER_CONTROL 0x1a881
+#define GMU_BOOT_SLUMBER_OPTION 0x1cbf8
+#define GMU_GX_VOTE_IDX	0x1cbf9
+#define GMU_MX_VOTE_IDX	0x1cbfa
+#define GMU_FENCE0	0x23b11
+
+/* RSC sequencer (inside GMU block on a630). */
+#define A6XX_GPU_RSCC_RSC_STATUS0_DRV0	0x23404
+#define A6XX_RSCC_PDC_SLAVE_ID_DRV0	0x2340b
+#define A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR	0x2340d
+#define A6XX_RSCC_HIDDEN_TCS_CMD0_DATA	0x2340e
+#define A6XX_RSCC_PDC_SEQ_START_ADDR	0x23408
+#define A6XX_RSCC_PDC_MATCH_VALUE_LO	0x23409
+#define A6XX_RSCC_PDC_MATCH_VALUE_HI	0x2340a
+#define A6XX_RSCC_OVERRIDE_START_ADDR	0x23500
+#define A6XX_RSCC_SEQ_MEM_0_DRV0	0x23580
+
+/* AOSS PDC (dword offsets, like the vendor _regwrite()). */
+#define PDC_GPU_ENABLE_PDC		0x21140
+#define PDC_GPU_SEQ_START_ADDR		0x21148
+#define PDC_GPU_TCS1_CONTROL		0x21572
+#define PDC_GPU_TCS1_CMD_ENABLE_BANK	0x21573
+#define PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK 0x21574
+#define PDC_GPU_TCS1_CMD0_MSGID		0x21575
+#define PDC_GPU_TCS1_CMD0_ADDR		0x21576
+#define PDC_GPU_TCS1_CMD0_DATA		0x21577
+#define PDC_GPU_TCS3_CONTROL		0x215d6
+#define PDC_GPU_TCS3_CMD_ENABLE_BANK	0x215d7
+#define PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK 0x215d8
+#define PDC_GPU_TCS3_CMD0_MSGID		0x215d9
+#define PDC_GPU_TCS3_CMD0_ADDR		0x215da
+#define PDC_GPU_TCS3_CMD0_DATA		0x215db
+#define PDC_GPU_SEQ_MEM_0		0xa0000
+#define PDC_CMD_OFFSET			4
+
+#define RBBM_STATUS		0x210
+#define RBBM_INT_STATUS		0x201
+#define CP_RB_BASE		0x800
+#define CP_RB_CNTL		0x802
+#define CP_RB_RPTR		0x806
+#define CP_RB_WPTR		0x807
+#define CP_SQE_CNTL		0x808
+#define CP_HW_FAULT		0x821
+#define CP_STATUS_1		0x825
+#define CP_SQE_INSTR_BASE	0x830
+
+static bool is_on(uint64_t gdscr)
+{
+	return (rd32(gdscr) >> 31) & 1;
+}
+
+static bool clk_on(uint64_t cbcr)
+{
+	return !(rd32(cbcr) >> 31);	/* CLK_OFF */
+}
+
+bool a6_cx_up(void)
+{
+	return is_on(GPUCC + GPUCC_CX_GDSCR) && clk_on(GPUCC + GPUCC_AHB) && clk_on(GPUCC + GPUCC_CX_GMU);
+}
+
+bool a6_gx_up(void)
+{
+	return a6_cx_up() && is_on(GPUCC + GPUCC_GX_GDSCR);
+}
+
+bool a6_cp_running(const struct a6_gpu *g)
+{
+	return a6_gx_up() && rd32(GREG(CP_SQE_INSTR_BASE)) == (uint32_t)a6_pool_va(A6_OFF_SQE) && g->gpu_cb >= 0;
+}
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa)
+{
+	memset(g, 0, sizeof(*g));
+	g->pool_pa = pool_pa;
+	g->gmu_smr = g->gmu_cb = g->gpu_smr = g->gpu_cb = -1;
+	if (a6_hfi_base_mode == 1)
+		g->va_hfi = 0x60000000u;	/* vendor allocate_gmu_kmem entry 0 */
+	else if (a6_hfi_base_mode == 2)
+		g->va_hfi = 0x60001000u;	/* mainline first free range */
+	else
+		g->va_hfi = 0x60005000u;
+	g->va_log = 0x60010000u;
+	g->va_dummy = 0x60020000u;
+}
+
+/* ---- stage 1: clocks and CX power ---- */
+
+/* Log a stage and let the persistent log ring flush it before the next
+ * register access: a bad SMMU/PDC/GX write can hang the whole SoC. */
+static void stage(const char *name)
+{
+	a6_log("stage: %s\n", name);
+	a6_delay_ms(300);
+}
+
+#define STAGE_OK(n, name) do {						\
+	a6_log("stage %d ok: %s\n", (n), (name));			\
+	a6_delay_ms(300);						\
+	if (a6_stage_limit <= (n)) {					\
+		a6_log("stopping after stage %d (sweetgpustage)\n", (n));	\
+		return 0;						\
+	}								\
+} while (0)
+
+
+static void branch_on(const char *name, uint64_t reg)
+{
+	wr32(reg, rd32(reg) | 1);
+	int rc = wait_bit(reg, 1u << 31, 0, 10);
+	a6_log("%s = %x%s\n", name, rd32(reg), rc ? " (still halted)" : "");
+}
+
+/* Program and start gpu_cc_pll1 exactly like clk_fabia_pll_configure() +
+ * clk_fabia_pll_enable().  gpu_cc_gmu_clk_src's 500 MHz OPP selects this
+ * PLL as parent 3; without it the CX_GMU branch halts (bit 31 set). */
+static int gpucc_pll1_start(void)
+{
+	uint64_t p = GPUCC + GPUCC_PLL1;
+	uint32_t mode, opmode;
+
+	mode = rd32(p + PLL_MODE);
+	opmode = rd32(p + FABIA_OPMODE);
+	a6_log("gpucc pll1 pre: mode %x opmode %x l %x frac %x uctl %x\n",
+	       mode, opmode, rd32(p + PLL_L_VAL), rd32(p + FABIA_FRAC_VAL),
+	       rd32(p + FABIA_USER_CTL_LO));
+
+	/* clk_fabia_pll_configure(): L/frac, bypass hw update, release reset */
+	wr32(p + PLL_L_VAL, PLL1_L_VAL);
+	wr32(p + FABIA_FRAC_VAL, PLL1_FRAC_VAL);
+	wr32(p + PLL_MODE, rd32(p + PLL_MODE) | PLL_HW_UPDATE_LOGIC_BYPASS);
+	wr32(p + PLL_MODE, rd32(p + PLL_MODE) | PLL_RESET_N);
+
+	/* clk_fabia_pll_enable(): out off, standby, reset, run */
+	wr32(p + PLL_MODE, rd32(p + PLL_MODE) & ~PLL_OUTCTRL);
+	wr32(p + FABIA_OPMODE, 0);
+	(void)rd32(p + FABIA_OPMODE);
+	wr32(p + PLL_MODE, rd32(p + PLL_MODE) | PLL_RESET_N);
+	wr32(p + FABIA_OPMODE, 1);
+
+	int rc = wait_bit(p + PLL_MODE, PLL_LOCK_DET, 1, 100);
+	a6_log("gpucc pll1 lock: %s mode %x opmode %x\n",
+	       rc ? "TIMEOUT" : "ok", rd32(p + PLL_MODE), rd32(p + FABIA_OPMODE));
+	if (rc)
+		return -1;
+
+	wr32(p + FABIA_USER_CTL_LO, rd32(p + FABIA_USER_CTL_LO) | FABIA_PLL_OUT_MASK);
+	wr32(p + PLL_MODE, rd32(p + PLL_MODE) | PLL_OUTCTRL);
+	a6_log("gpucc pll1 on: mode %x opmode %x uctl %x active %d\n",
+	       rd32(p + PLL_MODE), rd32(p + FABIA_OPMODE),
+	       rd32(p + FABIA_USER_CTL_LO),
+	       !!(rd32(p + PLL_MODE) & PLL_ACTIVE_FLAG));
+	return 0;
+}
+
+static int power_cx(void)
+{
+	a6_log("before: cx_gdsc %x gx_gdsc %x gmu_rcg %x/%x ahb %x cxo %x cx_gmu %x\n",
+	       rd32(GPUCC + GPUCC_CX_GDSCR), rd32(GPUCC + GPUCC_GX_GDSCR), rd32(GPUCC + GPUCC_GMU_RCG),
+	       rd32(GPUCC + GPUCC_GMU_RCG + 4), rd32(GPUCC + GPUCC_AHB), rd32(GPUCC + GPUCC_CXO),
+	       rd32(GPUCC + GPUCC_CX_GMU));
+	branch_on("gcc gpu_cfg_ahb", GCC + 0x71004);
+	branch_on("gcc ddrss_gpu_axi", GCC + 0x44038);
+	branch_on("gcc gpu_memnoc_gfx", GCC + 0x7100c);
+	branch_on("gcc gpu_snoc_dvm_gfx", GCC + 0x71018);
+
+	uint64_t gdsc = GPUCC + GPUCC_CX_GDSCR;
+	wr32(gdsc, rd32(gdsc) & ~1u);
+	int rc = wait_bit(gdsc, 1u << 31, 1, 100);
+	a6_log("cx gdsc -> %x %s\n", rd32(gdsc), rc ? "TIMEOUT" : "on");
+	if (rc)
+		return -1;
+
+	/* GMU clock: gcc_gpu_gpll0_div_clk_src / 1.5 = 200 MHz
+	 * (vendor gpucc-sdm845 gmu_clk_src parent 6, div 2).  The 500 MHz
+	 * OPP instead selects gpu_cc_pll1 as parent 3, so PLL1 must lock
+	 * before the RCG is switched over. */
+	wr32(GCC + 0x52004, rd32(GCC + 0x52004) | (1u << 16));
+	a6_delay_ms(1);
+	if (a6_gmu_clk_500 && gpucc_pll1_start())
+		return -1;
+	uint64_t rcg = GPUCC + GPUCC_GMU_RCG;
+	uint32_t rcfg = a6_gmu_clk_500 ? ((3u << 8) | 1u) : ((6u << 8) | 2u);
+	wr32(rcg + 4, (rd32(rcg + 4) & ~0x71fu) | rcfg);
+	wr32(rcg, rd32(rcg) | 1u);
+	rc = wait_bit(rcg, 1, 0, 10);
+	a6_log("gmu rcg %x cfg %x %s (want %x)\n", rd32(rcg), rd32(rcg + 4),
+	       rc ? "UPDATE TIMEOUT" : "", rcfg);
+
+	branch_on("gpucc crc_ahb", GPUCC + GPUCC_AHB);
+	branch_on("gpucc cxo", GPUCC + GPUCC_CXO);
+	branch_on("gpucc cx_gmu", GPUCC + GPUCC_CX_GMU);
+	if (!a6_cx_up())
+		return -1;
+
+	/* Vendor gmu_enable_gdsc also enables the GX GDSC before the GMU
+	 * start; the a630 HFI handler touches the GX domain. */
+	uint64_t gxdsc = GPUCC + GPUCC_GX_GDSCR;
+	wr32(gxdsc, rd32(gxdsc) & ~1u);
+	int grc = wait_bit(gxdsc, 1u << 31, 1, 200);
+	a6_log("gx gdsc -> %x %s\n", rd32(gxdsc), grc ? "TIMEOUT" : "on");
+	a6_log("gmu fw_version %x init_result %x rpmh_state %x; smmu idr0 %x\n",
+	       rd32(GMU_REG(GMU_FW_VERSION)), rd32(GMU_REG(GMU_INIT_RESULT)), rd32(GMU_REG(GMU_RPMH_STATE)),
+	       rd32(SMMU + 0x20));
+	return 0;
+}
+
+/* ---- SMMU ---- */
+
+/* 4K pages for the GMU windows; priv: AP=00 (GMU code), else AP=01. */
+static void map_gmu_pages(uint64_t l3, uint32_t va, uint64_t pa, uint32_t size, int priv)
+{
+	for (uint32_t o = 0; o < size; o += 0x1000) {
+		uint32_t idx = ((va + o) >> 12) & 0x1ff;
+		wr64(l3 + 8 * idx, (pa + o) | (1u << 10) | (3u << 8) | (priv ? 0 : (1u << 6)) | 3u);
+	}
+}
+
+static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t mask)
+{
+	uint32_t t0sz = sid == GPU_SID ? 25 : 32;
+	uint64_t c = SMMU_CB(cb);
+	wr32(c + CB_SCTLR, 0);
+	wr32(CBA2R(cb), 1);					/* AArch64 descriptors */
+	wr32(CBAR(cb), (1u << 16) | (0xfu << 12) | (3u << 8) | (uint32_t)(cb + 1));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	wr64(c + CB_TTBR0, ttbr0);
+	wr32(c + CB_TCR, t0sz | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_MAIR0, 0x0000ff44);
+	wr32(c + CB_FSR, 0xffffffff);
+	wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20 | 0x40);		/* M TRE AFE CFRE CFIE */
+	wr32(SMMU + 0x68, 0);					/* TLBIALLNSNH */
+	wr32(SMMU + 0x70, 0);					/* TLBGSYNC */
+	wait_bit(SMMU + 0x74, 1, 0, 10);
+	wr32(S2CR(smr), (3u << 24) | (uint32_t)cb);
+	wr32(SMR(smr), (1u << 31) | (mask << 16) | sid);	/* qcom SMMU v2 mask [31:16] */
+	a6_log("smmu: smr%d %x s2cr %x -> cb%d cbar %x sctlr %x tcr %x tcr2 %x\n", smr,
+	       rd32(SMR(smr)), rd32(S2CR(smr)), cb, rd32(CBAR(cb)), rd32(c + CB_SCTLR),
+	       rd32(c + CB_TCR), rd32(c + CB_TCR2));
+}
+
+/* Bootloader/Qualcomm SMMU may prepend 0x400 to the TBU stream id.  Add
+ * exact-match aliases for the common GMU/GPU stream ids; SMR masks are not
+ * implemented on polaris. */
+static void smmu_alias(int cb, uint32_t sid)
+{
+	uint32_t want = (1u << 31) | sid;
+	/* SMR0 is the bootloader mask-probe scratch and does not accept writes
+	 * on polaris; use only the real groups 1..4. */
+	for (int i = 0; i <= 4; i++) {
+		if (rd32(SMR(i)) >> 31)
+			continue;
+		wr32(S2CR(i), (3u << 24) | (uint32_t)cb);
+		wr32(SMR(i), want);
+		uint32_t got = rd32(SMR(i));
+		a6_log("smmu: alias smr%d sid %x -> cb%d (read %x)%s\n", i, sid, cb, got,
+		       got == want ? "" : " DID NOT STICK");
+		if (got == want)
+			return;
+	}
+	a6_log("smmu: no writable SMR for sid %x alias\n", sid);
+}
+
+static int smmu_pick(int32_t *smr_out, int32_t *cb_out, int cb_min, uint32_t sid)
+{
+	int smr = -1, cb = -1;
+	uint32_t used_cb = 0;
+	for (int i = 0; i < 6; i++) {
+		uint32_t m = rd32(SMR(i)), c = rd32(S2CR(i));
+		if ((m >> 31) && ((c >> 16) & 3) == 0)
+			used_cb |= 1u << (c & 0xff);
+		if (m >> 31)
+			a6_log("smmu: smr%d busy %x s2cr %x\n", i, m, c);
+		/* Bootloader left a stream for this SID: take its bank over. */
+		if ((m >> 31) && ((m & 0xffff) == sid || (m & 0x3ff) == sid) &&
+		    ((c >> 16) & 3) == 0) {
+			*smr_out = i;
+			*cb_out = c & 0xff;
+			a6_log("smmu: reuse smr%d -> cb%d for sid %u\n", i, *cb_out, sid);
+			return 0;
+		}
+		a6_log("smmu: smr%d = %x s2cr %x\n", i, m, c);
+		if (smr < 0 && i >= 1 && i <= 4 && !(m >> 31))
+			smr = i;
+	}
+	for (int k = 0; k < 6; k++) {
+		int i = (cb_min + k) % 6;
+		if (cb < 0 && !(used_cb & (1u << i)) && !(rd32(SMMU_CB(i) + CB_SCTLR) & 1))
+			cb = i;
+	}
+	*smr_out = smr;
+	*cb_out = cb;
+	return smr < 0 || cb < 0 ? -1 : 0;
+}
+
+void a6_tlb_flush(const struct a6_gpu *g)
+{
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TLBIALL, 0);
+	wr32(c + CB_TLBSYNC, 0);
+	wait_bit(c + CB_TLBSTATUS, 1, 0, 10);
+}
+
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0)
+{
+	if (g->gpu_cb < 0)
+		return 0;
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	if (far)
+		*far = rd32(c + CB_FAR) | ((uint64_t)rd32(c + CB_FAR + 4) << 32);
+	if (fsynr0)
+		*fsynr0 = rd32(c + CB_FSYNR0);
+	return rd32(c + CB_FSR) & A6_FSR_FAULT;
+}
+
+int a6_clear_fault(const struct a6_gpu *g)
+{
+	uint64_t far;
+	uint32_t syn, fsr = a6_fault_status(g, &far, &syn);
+	if (!fsr)
+		return 0;
+	a6_log("clearing smmu cb%d fault: fsr %x far %llx fsynr0 %x\n", g->gpu_cb, fsr,
+	       (unsigned long long)far, syn);
+	wr32(SMMU_CB(g->gpu_cb) + CB_FSR, rd32(SMMU_CB(g->gpu_cb) + CB_FSR));
+	return 1;
+}
+
+/* ---- stage 2: GMU boot ---- */
+
+static int gmu_smmu(struct a6_gpu *g)
+{
+	if (smmu_pick(&g->gmu_smr, &g->gmu_cb, 0, GMU_SID)) {
+		a6_log("smmu: no free smr/cb for the GMU\n");
+		return -1;
+	}
+	zero_pa(g->pool_pa, 0x100000);
+	wr64(GMEM_L1(g) + 0, GMEM_L2_0(g) | 3);
+	wr64(GMEM_L1(g) + 8, GMEM_L2_1(g) | 3);
+	wr64(GMEM_L2_0(g) + 0, GMEM_L3_LOW(g) | 3);
+	wr64(GMEM_L2_1(g) + 8 * ((0x60000000u >> 21) & 0x1ff), GMEM_L3_6(g) | 3);
+	map_gmu_pages(GMEM_L3_LOW(g), VA_ICACHE, GMEM_ICACHE(g), CACHE_SIZE, 1);
+	map_gmu_pages(GMEM_L3_LOW(g), VA_DCACHE, GMEM_DCACHE(g), CACHE_SIZE, 1);
+	map_gmu_pages(GMEM_L3_6(g), g->va_dummy, GMEM_DUMMY(g), 0x4000, 0);
+	map_gmu_pages(GMEM_L3_6(g), g->va_log, GMEM_LOG(g), A6_GMU_LOG_SIZE, 0);
+	map_gmu_pages(GMEM_L3_6(g), g->va_hfi, GMEM_HFI(g), 0x4000, 0);
+	stage("gmu smmu bank");
+	smmu_bank(g->gmu_smr, g->gmu_cb, GMEM_L1(g), GMU_SID, GMU_SID_MASK);
+	smmu_alias(g->gmu_cb, 4);
+	return 0;
+}
