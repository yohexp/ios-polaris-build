+uint32_t
+a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords,
+    unsigned n, unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint32_t dw[4 + 4 * A6_SUBMIT_MAX + 5], k = 0;
+	if (n == 0 || n > A6_SUBMIT_MAX)
+		return 0;
+	dw[k++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
+	dw[k++] = 0x18;				/* PC_CCU_INVALIDATE_DEPTH */
+	dw[k++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
+	dw[k++] = 0x19;				/* PC_CCU_INVALIDATE_COLOR */
+	for (unsigned i = 0; i < n; i++) {
+		dw[k++] = a6_pkt7(A6_CP_INDIRECT_BUFFER, 3);
+		dw[k++] = (uint32_t)iova[i];
+		dw[k++] = (uint32_t)(iova[i] >> 32);
+		dw[k++] = dwords[i] & 0xfffff;
+	}
+	dw[k++] = a6_pkt7(A6_CP_EVENT_WRITE, 4);
+	dw[k++] = 0x04;				/* CACHE_FLUSH_TS: the fence */
+	dw[k++] = (uint32_t)fva;
+	dw[k++] = (uint32_t)(fva >> 32);
+	dw[k++] = g->fence + 1;
+	/* room in the ring: what the CP has not read yet stays intact */
+	for (unsigned i = 0; ; i++) {
+		uint32_t r = rd32(GREG(CP_RB_RPTR)), used = (g->wptr + A6_RING_DW - r) % A6_RING_DW;
+		if (used + k + 16 < A6_RING_DW)
+			break;
+		if (i >= timeout_ms)
+			return 0;
+		a6_delay_ms(1);
+	}
+	uint32_t w = g->wptr, first = k < A6_RING_DW - w ? k : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < k)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (k - first));
+	g->wptr = (w + k) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	return ++g->fence;
+}
+
+uint32_t
+a6_submit_ib_async(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	return a6_submit_ibs_async(g, &iova, &dwords, 1, timeout_ms);
+}
+
+bool
+a6_fence_done(const struct a6_gpu *g, uint32_t fence)
+{
+	return (int32_t)(a6_fence_read(g) - fence) >= 0;
+}
+
+void
+a6_fence_force(struct a6_gpu *g)
+{
+	uint32_t v = g->fence;
+	a6_write(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+}
+
+uint64_t
+a6_timestamp(const struct a6_gpu *g)
+{
+	(void)g;
+	uint32_t hi = rd32(GREG(0x0981)), lo = rd32(GREG(0x0980)), hi2 = rd32(GREG(0x0981));
+	if (hi2 != hi)
+		lo = rd32(GREG(0x0980));
+	return (uint64_t)hi2 << 32 | lo;
+}
+
+/* No soft reset yet: a hung GPU is marked unusable and the clients fall back. */
+int
+a6_recover(struct a6_gpu *g)
+{
+	(void)g;
+	return -1;
+}
